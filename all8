                    "code": "FACTUAL_WCONPROD_PROTECTED",
                    "keyword": keyword,
                    "well": well_name,
                    "severity": "error",
                    "message": "Фактический WCONPROD нельзя изменять generic operation.",
                })
        if keyword == "WELTARG":
