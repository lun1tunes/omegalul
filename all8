        assert "INCLUDE_QUOTE_UNTERMINATED" in codes

        utf16 = Path(tmp) / "utf16.INC"
        utf16.write_bytes("DATES\n/\n".encode("utf-16"))
        code, result = checker.run(
            checker.build_parser().parse_args([str(utf16)])
