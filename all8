def _plural_wells(count: int, case: str = "gen") -> str:
    """Russian agreement for 'скважина': gen — '(даты) 1 скважины / 3 скважин', acc — 'добавил 1 скважину / 3 скважины / 5 скважин'."""
    if case == "acc":
