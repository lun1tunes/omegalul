                block.keyword == "WCONPROD"
                and any(
                    rec.tokens
                    and rec.tokens[0].strip("'\"") == well_name
                    and ("факт" in str(rec.comment).casefold() or "fact" in str(rec.comment).casefold())
                    for rec in block.records
                )
                for block in built_doc.blocks
            )
