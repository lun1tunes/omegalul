            },
            "data": {},
        }
    }

    class _Resp:
        headers: dict[str, str] = {}

        def __init__(self, body: bytes):
            self._body = body

        def read(self):
            return self._body

        def __enter__(self):
            return self

        def __exit__(self, *args):
            return False

