ROOT = Path(__file__).resolve().parents[1]
ACTIVITY_PY = ROOT / "mas-activity-service" / ".venv" / "bin" / "python"
# Order matters: generate_schedule_workflows.py ends with relayout_core_workflows.py, which normalises node
