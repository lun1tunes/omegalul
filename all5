        "jsCode": "const prepared=$('Prepare trajectory intersection request').first().json||{};\nconst packet=prepared.specialist_packet||{};\nlet response=$json;if(response?.body&&typeof response.body==='object')response=response.body;\nconst finite=value=>typeof value==='number'&&Number.isFinite(value);\nconst results=Array.isArray(response?.results)?response.results:[];\nconst expected=Array.isArray(prepared.trajectory_filenames)?prepared.trajectory_filenames:[];\nconst valid=results.length===expected.length&&results.length>0&&results.every(value=>value&&typeof value.filename==='string'&&value.filename&&finite(value.intersection_md)&&finite(value.x)&&finite(value.y)&&finite(value.z));\nconst returnedNames=results.map(value=>value?.filename);\nconst filenamesMatch=valid&&expected.every(name=>returnedNames.includes(name))&&new Set(returnedNames).size===returnedNames.length;\nconst passed=valid&&filenamesMatch;\nconst status=passed?'succeeded':'retryable_error';\nconst summary=passed?`Math Service calculated ${results.length} DEV trajectory/CPS3 surface intersections in one batch.`:'Math Service returned an invalid or incomplete batch trajectory-intersection response.';\nconst calculation=passed?{results:results.map(value=>({filename:value.filename,intersection_md:value.intersection_md,x:value.x,y:value.y,z:value.z})),trajectory_count:results.length,result_mode:'computed_batch'}:{};\nconst reasonCodes=passed?['TRAJECTORY_INTERSECTION_BATCH_COMPUTED']:['MATH_SERVICE_BATCH_RESPONSE_INVALID'];\nconst checks=[{check:'math_service_batch_response_contract',passed:valid},{check:'one_result_per_trajectory_filename',passed:filenamesMatch},{check:'finite_intersection_coordinates',passed}];\nconst assumptions=['All trajectories and the surface use the same CRS, length units, vertical datum and Z sign convention.'];\nconst considered=[...expected.map(filename=>({kind:'dev_trajectory',filename})),{kind:'ascii_cps3_surface',filename:prepared.surface_filename}];\nconst decision={