    def is_recordless(self) -> bool:
        layout = self.layout
        return (
            not self.fields
            and int(self.parser.token_width or 0) == 0
            and str(layout.record_terminator).upper() == "NONE"
            and str(layout.block_terminator).upper() == "NONE"
