                  "knowledge_id": "endactio-action-close-v1",
                  "revision": "2",
                  "title": "ENDACTIO — конец условного блока ACTION*",
                  "keywords": [
                    "ENDACTIO"
                  ],
                  "topics": [
                    "ENDACTIO",
                    "конец ACTIONX",
                    "не ENDACTION"
