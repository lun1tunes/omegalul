            "from pathlib import Path; p=Path('/data/activity_state.json'); p.parent.mkdir(parents=True, exist_ok=True); p.write_text('{\"tasks\":{}}')",
        ],
        check=False,
    )
    key = env.get("MAS_ACTIVITY_KEY", "")
    if key:
        req = urllib.request.Request(
