# FastAPI Excel tools. Copy to excel-tools.env.
# Auth is off. Set API_KEY only if n8n should send X-API-Key (then add Header Auth on the agent).
# API_KEY=

# Поле: 0.0.0.0 если корпоративный n8n на другом хосте. lab: контейнер слушает 0.0.0.0 сам.
EXCEL_TOOLS_HOST=127.0.0.1
EXCEL_TOOLS_PORT=8000
LOG_LEVEL=INFO

# Fallback if the n8n task does not pass activity_base_url (Runtime Config).
ACTIVITY_BASE_URL=http://127.0.0.1:8200

SESSION_DIR=./data/sessions
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=200
MAX_EXCEL_ZIP_ENTRIES=10000
MAX_EXCEL_UNCOMPRESSED_MB=500
MAX_INTERNAL_BLANK_ROWS=5
MAX_PREVIEW_ROWS=100
MAX_QUERY_PREVIEW_ROWS=100
EXCEL_TOOLS_ENABLE_DOCS=false
# EXCEL_LEGACY_API=1
