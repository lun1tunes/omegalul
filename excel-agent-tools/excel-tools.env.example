# FastAPI Excel tools only. Copy to excel-tools.env and replace the key.
API_KEY=change-me-long-random-excel-tools-key

# 127.0.0.1: only this Windows PC. 0.0.0.0: allow an approved remote n8n host.
EXCEL_TOOLS_HOST=127.0.0.1
EXCEL_TOOLS_PORT=8000

# Fallback if the n8n task does not pass activity_base_url (Runtime configuration).
ACTIVITY_BASE_URL=http://127.0.0.1:8200

SESSION_DIR=./data/sessions
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=200
MAX_EXCEL_ZIP_ENTRIES=10000
MAX_EXCEL_UNCOMPRESSED_MB=500
MAX_INTERNAL_BLANK_ROWS=5
MAX_PREVIEW_ROWS=100
MAX_QUERY_PREVIEW_ROWS=100
EXCEL_TOOLS_ENABLE_DOCS=false
