        )
        try:
            row = control_plane.get_case(case_id)
            if row:
                state = dict(row["state"] or {})
                state["last_error"] = {"message": str(exc)[:500]}
                control_plane.update_case(case_id, state=state, status="failed")
        except KeyError:
            pass


