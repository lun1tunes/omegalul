.turn.outcome-ok,
.turn.outcome-wait,
.turn.outcome-block,
.turn.outcome-info { border-left: 2px solid transparent; padding-left: 0.35rem; }
.turn.outcome-ok { border-left-color: var(--ok); }
.turn.outcome-wait { border-left-color: var(--wait); }
.turn.outcome-block { border-left-color: var(--block); }
.turn.outcome-info { border-left-color: var(--blue-500); }

.who {
  display: flex;
  align-items: center;
  gap: 0.5rem;
