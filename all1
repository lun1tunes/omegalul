.meta-line {
  margin-top: 0.75rem;
  font-family: var(--mono);
  font-size: 0.7rem;
  color: var(--muted);
}

.gate-panel {
  margin: 0 clamp(1.25rem, 3vw, 3rem) 0.65rem;
  padding: 0.45rem 0.85rem;
