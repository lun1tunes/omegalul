        "contract": "mas_knowledge_document",
        "contract_version": "1.0",
        "status": "created",
        "document": doc,
    }


@app.patch("/v1/knowledge/documents/{target_base}/{knowledge_id}")
def knowledge_patch_document(
    target_base: str,
