            "from_role": requested_by,
            "to_role": "Orchestrator",
            "from_specialist": "human_operator",
            "to_specialist": "universal_orchestrator",
            "details": {
                "action": "start",
                "requested_by": requested_by,
                "objective": description[:4000],
                "file_count": len(file_names),
