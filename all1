      const spec = frame.nodes[key] || { tone: "idle" };
      const tone = spec.tone || "idle";
      el.className = `schema-node is-${tone === "error" ? "failed" : tone}`;
      const q0 = text(spec.hitl_question);
      const a0 = text(spec.hitl_answer);
