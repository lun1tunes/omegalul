# Same rows the database is seeded with — generated by n8n/templates/generate_mas_control_plane_proxy.py
# from mas_agent_registry.SEED. Used only when no Control Plane Proxy is configured (tests, offline harness).
_SEED_FILE = Path(__file__).resolve().parent / "sql" / "agent_registry_seed.json"


def _load_registry_seed() -> list[dict[str, Any]]:
    try:
        rows = json.loads(_SEED_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return [dict(row) for row in rows if isinstance(row, dict) and row.get("agent_id")]


