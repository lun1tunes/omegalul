  font-weight: 500;
  text-transform: uppercase;
  color: var(--blue-500);
}
.who .role {
  font-weight: 500;
  color: var(--ink);
}
.who .role.you {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--blue-900);
}
.who .arrow {
  position: relative;
  display: inline-block;
  width: 1.15rem;
  height: 2px;
  flex: 0 0 auto;
  background: var(--blue-500);
  font-size: 0;
  color: transparent;
}
.who .arrow::after {
  content: "";
  position: absolute;
  right: -1px;
  top: 50%;
  width: 5px;
  height: 5px;
  border-right: 2px solid var(--blue-500);
  border-top: 2px solid var(--blue-500);
  transform: translateY(-50%) rotate(45deg);
}
.who.dir-in .arrow::after {
  right: auto;
  left: -1px;
  border-right: 0;
  border-top: 0;
  border-left: 2px solid var(--blue-500);
  border-bottom: 2px solid var(--blue-500);
}
.who.human .who-kicker { color: var(--blue-700); }

.bubble {
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}
.duration {
  font-family: var(--mono);
  font-size: 0.7rem;
  color: var(--muted);
}
.brief {
  margin: 0;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--ink);
}
.muted-line {
  margin: 0.5rem 0 0;
  color: var(--muted);
  font-size: 0.875rem;
}
.bubble .text {
  margin: 0;
  line-height: 1.5;
}
.chips {
  display: flex;
  flex-wrap: wrap;
