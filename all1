    if sheet not in frames:
        raise ToolError("SHEET_NOT_FOUND", f"Sheet {sheet} not found", {"available_sheets": list(frames)})
    frame = frames[sheet]
    end = min(max_row or len(frame), len(frame))
    for index in range(max(1, min_row), end + 1):
