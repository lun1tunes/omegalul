}
.rail .id {
  display: block;
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--blue-700);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rail .id.named {
  font-family: var(--sans);
  font-size: 0.82rem;
}
.rail .meta {
  display: block;
  color: var(--muted);
  font-size: 0.7rem;
  margin-top: 0.2rem;
  line-height: 1.35;
}
.rail .hitl-flag {
