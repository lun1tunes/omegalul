}
a.btn.schedule-download,
.schedule-download {
  display: inline-flex;
  align-items: center;
  text-transform: none;
  letter-spacing: 0;
  font-family: var(--sans);
  font-size: 0.78rem;
  font-weight: 600;
  padding: 0.4rem 0.8rem;
  white-space: nowrap;
  text-decoration: none;
  background: #fff;
  color: var(--blue-700);
  border: 2px solid rgba(0, 51, 160, 0.45);
  box-shadow: none;
}
a.btn.schedule-download:hover:not(:disabled),
.schedule-download:hover:not(:disabled) {
  background: #fff;
  color: var(--blue-700);
  border-color: var(--blue-700);
  transform: none;
}

.thread {
  list-style: none;
  margin: 0;
  padding: 0 0 2rem;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.empty {
