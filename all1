        path.setAttribute(vis.dir === "back" ? "marker-start" : "marker-end", `url(#${marker})`);
        path.removeAttribute(vis.dir === "back" ? "marker-end" : "marker-start");
      } else {
        path.removeAttribute("marker-end");
        path.removeAttribute("marker-start");
