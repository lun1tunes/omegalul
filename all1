  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--ink);
}
.diff-row {
  display: grid;
  gap: 0.5rem;
}
.diff-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  color: var(--muted);
}
.diff-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.diff-chip {
  font-family: var(--mono);
  font-size: 0.75rem;
