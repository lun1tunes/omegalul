                "task_name": str(state.get("task_name") or ""),
                "requested_by": "mas activity user",
            },
            timeout_s=180.0,
        )
    except OrchestratorError as exc:
        logger.error("orchestrator %s failed case_id=%s: %s", action, case_id, exc)
        control_plane.append_event(
