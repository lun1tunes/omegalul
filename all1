    fixMarkerOrientation();
    const key = `${index}|${JSON.stringify(frame.nodes)}|${JSON.stringify(frame.edges)}|${deliverableCards.length}|${inputCards.length}|${complete}|${stage.clientWidth}|${stage.clientHeight}`;
    if (key !== lastKey) {
      lastKey = key;
