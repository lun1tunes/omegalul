_EVENTS: dict[str, list[dict[str, Any]]] = {}
_ERRORS: dict[str, list[dict[str, Any]]] = {}
_EXECUTIONS: dict[str, dict[str, Any]] = {}
_EVENT_SEQ = 0
_ERROR_SEQ = 0

