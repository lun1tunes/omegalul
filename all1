}
.composer-attach-row .composer-actions {
  flex: 0 0 auto;
  align-self: center;
}
.composer-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.reply-field input,
.reply-field textarea {
  width: 100%;
}
.reply-field textarea {
  resize: vertical;
