/* База знаний — reuses the workspace design system (app.css) */

.knowledge-page .flash.flash-ok { background: var(--brand-blue); }

.kb-stage {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 264px minmax(0, 1fr);
  height: calc(100vh - var(--top-h));
}

/* ------------------------------------------------------------------ side */
.kb-side {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 18px 14px 20px;
  border-right: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.55);
  overflow-y: auto;
}
.kb-side-title {
  padding: 0 8px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-2);
}
.kb-tabs { display: flex; flex-direction: column; gap: 2px; }
.kb-tab {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  text-align: left;
  color: var(--ink);
  font-weight: 500;
  font-size: 13.5px;
  position: relative;
  transition: background var(--t-fast) var(--ease);
}
.kb-tab:hover { background: rgba(0, 51, 160, 0.05); }
.kb-tab.is-active { background: var(--paper); box-shadow: var(--shadow-1), inset 0 0 0 1px var(--line); color: var(--brand-blue); }
.kb-tab.is-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 3px;
  background: var(--brand-blue);
}
.kb-tab-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kb-tab-count { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }

.kb-select-fallback { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.kb-side-note { margin: 10px 8px 0; font-size: 12.5px; color: var(--muted); line-height: 1.5; }
.kb-ingest-btn { margin: 6px 0 0; width: 100%; }

/* ------------------------------------------------------------------ main */
.kb-main {
  min-width: 0;
  overflow-y: auto;
  background: var(--paper);
  padding: 20px 28px 48px;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}
.kb-main > * { max-width: 960px; margin-left: auto; margin-right: auto; }

.kb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}
.kb-hint { margin: 0; color: var(--muted); font-size: 13.5px; }
.kb-head-tools { display: flex; align-items: center; gap: 10px; flex: none; }
.kb-search { width: 260px; }
.kb-count { font-size: 12px; color: var(--muted-2); white-space: nowrap; }

/* create panel */
.kb-create {
  margin-bottom: 18px;
  padding: 20px 22px 18px;
  border-radius: var(--r-lg);
  background: var(--panel);
  box-shadow: inset 0 0 0 1px var(--line);
  display: grid;
  gap: 4px;
  animation: turn-in var(--t-base) var(--ease);
