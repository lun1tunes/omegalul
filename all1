# MAS Activity UI. Copy to mas-activity.env.
# python -m app (start-windows.bat / start-linux.sh) loads this file automatically,
# same pattern as excel-tools.env. A process environment always wins.

# 127.0.0.1: only this PC. 0.0.0.0: allow an approved remote n8n host.
MAS_ACTIVITY_HOST=127.0.0.1
MAS_ACTIVITY_PORT=8200
LOG_LEVEL=INFO
# Keep true in production. Set false only for a trusted local/self-signed endpoint.
ACTIVITY_TLS_VERIFY=true
# Preferred for corporate/self-signed PKI: keep verification enabled and point to a CA PEM.
# ACTIVITY_CA_BUNDLE=/absolute/path/to/corporate-ca.pem

# n8n — production path only (no local demo mode).
# Prefer the orchestrator webhook. Hydrate/healthz are derived from the same host.
ORCHESTRATOR_WEBHOOK_URL=http://127.0.0.1:15678/webhook/mas-orchestrator-step
# Same n8n Postgres as Orchestrator. On startup Activity runs CREATE IF NOT EXISTS
# for cases/events/error_traces/executions/agent_registry (never DROP).
# The DB role needs CREATE TABLE. pgvector is a separate DBA step for RAG.
# DATABASE_URL=postgresql://n8n:PASSWORD@127.0.0.1:15432/n8n
# ORCHESTRATOR_WORKFLOW_ID=e9bbdb6e-3b7c-5dc0-851a-30bd9f2eb0d6
# If the webhook uses header auth in n8n:
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=

# Optional: REST fallback instead of webhook (n8n user/password).
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_USERNAME=
# N8N_PASSWORD=
# ORCHESTRATOR_WORKFLOW_ID=ba8ba59f-e4e4-5ff6-b22c-63ceae883271

# Optional override if the hydrate webhook is not on the same n8n host as ORCHESTRATOR_WEBHOOK_URL.
# ACTIVITY_HYDRATE_URL=http://127.0.0.1:5678/webhook/mas-activity-hydrate
