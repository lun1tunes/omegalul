def sql_statements(sql_text: str) -> list[str]:
    """Keep the old parser as a safety test for the checked-in schema contract."""
    cleaned = "\n".join(line for line in sql_text.splitlines() if not line.strip().startswith("--"))
    statements: list[str] = []
    buf: list[str] = []
    in_string = False
    i = 0
    while i < len(cleaned):
        ch = cleaned[i]
        if ch == "'" and in_string:
            if i + 1 < len(cleaned) and cleaned[i + 1] == "'":
                buf.append("''")
                i += 2
                continue
            in_string = False
        elif ch == "'":
            in_string = True
        if ch == ";" and not in_string:
            stmt = "".join(buf).strip()
            if stmt:
                statements.append(stmt)
            buf = []
        else:
            buf.append(ch)
        i += 1
    tail = "".join(buf).strip()
    if tail:
        statements.append(tail)
    return statements


