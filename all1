  --brand-blue: #0033A0;
  --brand-cyan: #00B8F0;
  --brand-red: #F90D4B;

  --ink: #0f1a33;
  --ink-2: #33415c;
  --muted: #64748b;
  --muted-2: #94a3b8;
  --line: #e3e8f0;
  --line-soft: #eef2f7;
  --paper: #ffffff;
  --panel: #f7f9fc;
  --panel-2: #f1f5fa;

  --blue-50: #f2f8ff;
  --blue-100: #e3efff;
  --blue-200: #c3dcff;
  --cyan-100: #e0f6fd;
  --cyan-200: #b8ecfb;
  --red-50: #fff1f4;
  --red-100: #ffdce4;
  --ok: #12996b;
  --ok-100: #dcf5ea;
  --wait: #d97a06;
  --wait-100: #fdeed6;

  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-xl: 20px;

  --shadow-1: 0 1px 2px rgba(15, 26, 51, 0.05), 0 1px 1px rgba(15, 26, 51, 0.03);
  --shadow-2: 0 8px 24px -12px rgba(0, 26, 87, 0.22), 0 2px 6px -2px rgba(15, 26, 51, 0.06);
  --shadow-3: 0 24px 56px -24px rgba(0, 26, 87, 0.35), 0 6px 16px -8px rgba(15, 26, 51, 0.12);
  --ring: 0 0 0 3px rgba(0, 184, 240, 0.28);

  --font: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mono: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;

  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  --t-fast: 140ms;
  --t-base: 220ms;
  --t-slow: 420ms;

  --top-h: 60px;
  --rail-w: 292px;
  --inspector-w: 328px;
}

*, *::before, *::after { box-sizing: border-box; }

html, body {
  height: 100%;
  margin: 0;
  overscroll-behavior: none;
}

body {
  font-family: var(--font);
  font-size: 14.5px;
  line-height: 1.5;
  color: var(--ink);
  background:
    radial-gradient(1200px 600px at 80% -20%, rgba(0, 184, 240, 0.07), transparent 60%),
    radial-gradient(900px 500px at -10% 110%, rgba(0, 51, 160, 0.06), transparent 60%),
    var(--panel);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-feature-settings: "cv05", "ss01";
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

::selection { background: rgba(0, 184, 240, 0.28); }

button, input, select, textarea {
  font: inherit;
  color: inherit;
}

button { cursor: pointer; }

a { color: var(--brand-blue); text-decoration: none; }
a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

:focus-visible { outline: none; box-shadow: var(--ring); border-radius: var(--r-sm); }

[hidden] { display: none !important; }

.icon {
  width: 16px;
  height: 16px;
  flex: none;
  display: inline-block;
  vertical-align: middle;
}
.icon.flip { transform: scaleX(-1); }

.mono { font-family: var(--mono); font-size: 0.92em; }

/* ------------------------------------------------------------------ header */
.top {
  height: var(--top-h);
  flex: none;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 0 20px 0 18px;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: saturate(140%) blur(10px);
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 30;
}

.top .rail-toggle { display: none; }

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--brand-ink);
  min-width: 0;
  margin-right: auto;
}
.brand:hover { text-decoration: none; }

.brand-mark {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: linear-gradient(160deg, var(--blue-50), var(--cyan-100));
  display: grid;
  place-items: center;
  box-shadow: inset 0 0 0 1px rgba(0, 51, 160, 0.10);
}

.brand-lockup { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
.brand-row { display: flex; align-items: baseline; gap: 8px; white-space: nowrap; }
.brand .mark { font-weight: 700; letter-spacing: -0.01em; font-size: 15px; }
.brand .product { font-weight: 500; color: var(--brand-blue); font-size: 15px; }
.brand-sub {
  font-size: 11.5px;
  color: var(--muted);
  letter-spacing: 0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-actions { display: flex; align-items: center; gap: 4px; }

.nav-link {
  padding: 7px 12px;
  border-radius: 999px;
  color: var(--ink-2);
  font-weight: 500;
  font-size: 13.5px;
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
}
.nav-link:hover { background: var(--panel-2); color: var(--ink); text-decoration: none; }
.nav-link.is-current { background: var(--blue-100); color: var(--brand-blue); }

/* ------------------------------------------------------------------ toasts */
.flash {
  position: fixed;
  top: calc(var(--top-h) + 12px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  max-width: min(640px, calc(100vw - 32px));
  padding: 10px 16px;
  border-radius: var(--r-md);
  background: var(--brand-ink);
  color: #fff;
  font-size: 13.5px;
  box-shadow: var(--shadow-3);
  animation: flash-in var(--t-base) var(--ease);
}
.flash.error { background: #a10a33; }
.flash.warn  { background: #b8620a; }
.flash.info  { background: var(--brand-blue); }
@keyframes flash-in { from { opacity: 0; transform: translate(-50%, -8px); } to { opacity: 1; transform: translate(-50%, 0); } }

.wait-bar {
  position: fixed;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  z-index: 55;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px 10px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-2);
  backdrop-filter: blur(8px);
  font-size: 13px;
  color: var(--ink-2);
  animation: flash-in var(--t-base) var(--ease);
}
.wait-copy { display: flex; align-items: baseline; gap: 8px; }
.wait-elapsed { color: var(--muted); font-variant-numeric: tabular-nums; }
.wait-spinner {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid var(--blue-200);
  border-top-color: var(--brand-blue);
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ------------------------------------------------------------------ buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 36px;
  padding: 0 14px;
  border-radius: 10px;
  border: 1px solid transparent;
  font-weight: 500;
  font-size: 13.5px;
  line-height: 1;
  white-space: nowrap;
  transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease),
              color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
}
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

.btn-primary {
  background: var(--brand-blue);
  color: #fff;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.15) inset, 0 6px 14px -8px rgba(0, 51, 160, 0.6);
}
.btn-primary:hover:not(:disabled) { background: #002d8f; }

.btn-quiet {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line);
}
.btn-quiet:hover:not(:disabled) { background: var(--paper); border-color: #cfd8e6; color: var(--ink); }

.btn-ghost { background: transparent; color: var(--brand-blue); }
.btn-ghost:hover:not(:disabled) { background: var(--blue-50); }

.icon-btn {
  width: 32px;
  height: 32px;
  display: inline-grid;
  place-items: center;
  border-radius: 9px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
}
.icon-btn:hover:not(:disabled) { background: var(--panel-2); color: var(--ink); }
.icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* ------------------------------------------------------------------ stage grid */
.stage {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: var(--rail-w) minmax(0, 1fr) var(--inspector-w);
  height: calc(100vh - var(--top-h));
}

/* ------------------------------------------------------------------ rail */
.rail {
  display: flex;
  flex-direction: column;
  min-height: 0;
  border-right: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.55);
}

.rail-head {
  padding: 16px 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rail-new-task { width: 100%; height: 38px; }

.rail-search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 34px;
  padding: 0 10px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--muted);
  transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
}
.rail-search:focus-within { border-color: var(--brand-cyan); box-shadow: var(--ring); }
.rail-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  outline: none;
  font-size: 13.5px;
  color: var(--ink);
}
.rail-search input::placeholder { color: var(--muted-2); }

.rail-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 8px 16px;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}

.rail-section {
  margin: 12px 8px 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-2);
}

.rail-item {
  width: 100%;
  display: grid;
  grid-template-columns: 10px 1fr;
  column-gap: 10px;
  align-items: start;
  padding: 10px 10px 10px 12px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  text-align: left;
  color: var(--ink);
  transition: background var(--t-fast) var(--ease);
  position: relative;
}
.rail-item + .rail-item { margin-top: 2px; }
.rail-item:hover { background: rgba(0, 51, 160, 0.05); }
.rail-item.is-active { background: var(--paper); box-shadow: var(--shadow-1), inset 0 0 0 1px var(--line); }
.rail-item.is-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 3px;
  background: var(--brand-blue);
}

.rail-item .dot { margin-top: 6px; }

.rail-item .rail-title {
  font-weight: 500;
  font-size: 13.5px;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: var(--ink);
}
.rail-item .rail-meta {
  margin-top: 3px;
  font-size: 12px;
  color: var(--muted);
  display: flex;
  gap: 6px;
  align-items: center;
  white-space: nowrap;
  overflow: hidden;
}
.rail-item .rail-meta .sep { color: var(--muted-2); }
.rail-item.attention .rail-title { color: var(--brand-ink); }
.rail-item .rail-badge {
  margin-left: auto;
  font-size: 11px;
  font-weight: 600;
  padding: 1px 7px;
  border-radius: 999px;
  background: var(--wait-100);
  color: #8a5a06;
}

.rail-empty { margin: 32px 20px; color: var(--muted); font-size: 13.5px; text-align: center; }

/* status dots — shared by rail, header, schema */
.dot, .status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--muted-2);
  flex: none;
  display: inline-block;
  position: relative;
}
.dot[data-tone="running"], .status-dot[data-tone="running"] { background: var(--brand-cyan); }
.dot[data-tone="running"]::after, .status-dot[data-tone="running"]::after {
  content: "";
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1.5px solid var(--brand-cyan);
  opacity: 0.6;
  animation: pulse 1.6s var(--ease) infinite;
}
.dot[data-tone="waiting"], .status-dot[data-tone="waiting"] { background: var(--wait); }
.dot[data-tone="done"], .status-dot[data-tone="done"] { background: var(--ok); }
.dot[data-tone="failed"], .status-dot[data-tone="failed"] { background: var(--brand-red); }
@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.7; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* ------------------------------------------------------------------ workspace */
.workspace {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  background: var(--paper);
  position: relative;
}

.work-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 24px 12px;
  border-bottom: 1px solid var(--line-soft);
  min-height: 64px;
}
.head-copy { min-width: 0; }

.work-head h1 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.3;
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
#titleText { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rename-task-btn { width: 28px; height: 28px; opacity: 0; transition: opacity var(--t-fast) var(--ease); }
.work-head h1:hover .rename-task-btn, .rename-task-btn:focus-visible { opacity: 1; }
.rename-task-input {
  flex: 1;
  min-width: 200px;
  height: 32px;
  padding: 0 10px;
  border-radius: 8px;
  border: 1px solid var(--brand-cyan);
  box-shadow: var(--ring);
  outline: none;
  font-weight: 600;
  font-size: 15px;
}

.head-meta {
  margin: 4px 0 0;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12.5px;
  color: var(--muted);
}
.head-id { font-family: var(--mono); font-size: 12px; color: var(--muted-2); }

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 22px;
  max-width: 100%;
  padding: 0 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  background: var(--panel-2);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status-pill[data-tone="running"] { background: var(--cyan-100); color: #026a8a; }
.status-pill[data-tone="waiting"] { background: var(--wait-100); color: #8a5a06; }
.status-pill[data-tone="done"] { background: var(--ok-100); color: #0b6b4a; }
.status-pill[data-tone="failed"] { background: var(--red-100); color: #a10a33; }
.status-pill[data-tone="idle"] { background: var(--panel-2); color: var(--ink-2); }

.head-tools { display: flex; align-items: center; gap: 10px; flex: none; }

.view-toggle {
  display: inline-flex;
  padding: 3px;
  border-radius: 10px;
  background: var(--panel-2);
  gap: 2px;
}
.view-toggle-btn {
  height: 30px;
  padding: 0 14px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  font-weight: 500;
  font-size: 13px;
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
}
.view-toggle-btn:hover { color: var(--ink); }
.view-toggle-btn.is-active, .view-toggle-btn[aria-selected="true"] { background: var(--paper); color: var(--brand-blue); box-shadow: var(--shadow-1); }

.inspector-toggle { display: none; height: 32px; padding: 0 12px; font-size: 13px; }

.work-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ------------------------------------------------------------------ chat pane */
.transcript {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 24px 0 32px;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}
.transcript > * { max-width: 860px; margin-left: auto; margin-right: auto; padding-left: 28px; padding-right: 28px; }

.request-panel {
  margin-bottom: 20px;
}
.request-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-2);
  margin-bottom: 6px;
}
.request-text {
  margin: 0;
  font-size: 16px;
  line-height: 1.5;
  color: var(--ink);
  white-space: pre-wrap;
  font-weight: 500;
  letter-spacing: -0.005em;
}
.request-files { margin-top: 12px; }

/* Plan (O13): the orchestrator's decomposition of the goal, under the task statement. */
.request-plan { margin-top: 16px; }
.request-plan-label { display: flex; align-items: baseline; gap: 8px; }
.request-plan-count { font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--muted); }
.plan-steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 6px;
}
.plan-step {
  display: grid;
  grid-template-columns: 18px 1fr;
  gap: 10px;
  align-items: start;
  font-size: 14px;
  line-height: 1.45;
  color: var(--ink);
}
.plan-step-mark {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  display: grid;
  place-items: center;
  font-size: 11px;
  color: #fff;
  box-sizing: border-box;
}
.plan-step[data-status="active"] .plan-step-mark { border-color: var(--brand-blue); box-shadow: 0 0 0 3px var(--blue-200); }
.plan-step[data-status="active"] .plan-step-mark::after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--brand-blue); animation: plan-pulse 1.4s ease-in-out infinite; }
.plan-step[data-status="done"] .plan-step-mark { background: var(--ok); border-color: var(--ok); }
.plan-step[data-status="done"] .plan-step-mark::after { content: "✓"; }
.plan-step[data-status="blocked"] .plan-step-mark { background: var(--brand-red); border-color: var(--brand-red); }
.plan-step[data-status="blocked"] .plan-step-mark::after { content: "!"; font-weight: 700; }
.plan-step[data-status="dropped"] { color: var(--muted); }
.plan-step[data-status="dropped"] .plan-step-title { text-decoration: line-through; }
.plan-step[data-status="dropped"] .plan-step-mark { border-style: dashed; }
.plan-step-title { font-weight: 500; }
.plan-step-meta { display: block; font-size: 12px; color: var(--muted); margin-top: 1px; }
.plan-step[data-status="active"] .plan-step-meta { color: var(--brand-blue); }
@keyframes plan-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.45; transform: scale(0.8); } }

.status-banner {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 4px 12px;
  align-items: baseline;
  margin-bottom: 20px;
  padding: 12px 16px;
  border-radius: var(--r-md);
  background: var(--blue-50);
  color: var(--brand-ink);
}
.status-banner[data-tone="waiting"] { background: var(--wait-100); color: #6b4600; }
.status-banner[data-tone="failed"] { background: var(--red-50); color: #8f0a2f; }
.status-banner[data-tone="done"] { background: var(--ok-100); color: #0b5c40; }
.status-banner[data-tone="idle"] { background: var(--panel); color: var(--ink-2); }
.status-banner-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.8; }
.status-banner-text { margin: 0; font-size: 13.5px; }

.empty {
  color: var(--muted);
  text-align: center;
  padding: 48px 0;
  font-size: 14px;
}

.not-found { text-align: center; padding: 64px 0; }
.not-found-title { margin: 0 0 6px; font-size: 18px; font-weight: 600; }
.not-found-id { margin: 0 0 4px; font-family: var(--mono); color: var(--muted); font-size: 13px; }
.not-found-copy { margin: 0 0 18px; color: var(--muted); }

/* thread */
.thread { list-style: none; margin: 0; padding-top: 0; padding-bottom: 0; display: flex; flex-direction: column; gap: 4px; }

.day-sep {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0 10px;
  color: var(--muted-2);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.day-sep::before, .day-sep::after { content: ""; flex: 1; height: 1px; background: var(--line-soft); }

.turn {
  display: grid;
  grid-template-columns: 34px 1fr;
  column-gap: 14px;
  padding: 6px 0;
  animation: turn-in var(--t-slow) var(--ease) both;
}
@keyframes turn-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.thread.no-anim .turn { animation: none; }

.turn.is-cont { padding-top: 0; }
.turn.is-cont .avatar { visibility: hidden; height: 0; }
.turn.is-cont .turn-head { display: none; }

.avatar {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--brand-blue);
  background: var(--blue-100);
  flex: none;
}
.avatar .icon { width: 17px; height: 17px; }
.turn[data-side="user"] .avatar { background: var(--panel-2); color: var(--ink-2); }
.turn[data-side="orchestrator"] .avatar { background: var(--brand-ink); color: #fff; }
.turn[data-side="agent"] .avatar { background: var(--cyan-100); color: #026a8a; }
.turn[data-side="system"] .avatar { background: var(--panel-2); color: var(--muted); }

.turn-main { min-width: 0; }

.turn-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 2px;
  line-height: 1.3;
}
.turn-name { font-weight: 600; font-size: 13.5px; color: var(--ink); }
.turn-to { color: var(--muted); font-size: 13px; }
.turn-to b { font-weight: 500; color: var(--ink-2); }
.turn-time { color: var(--muted-2); font-size: 12px; font-variant-numeric: tabular-nums; margin-left: auto; }

.turn-kicker {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 1px 7px;
  border-radius: 999px;
  background: var(--panel-2);
  color: var(--muted);
}
.turn-kicker[data-tone="result"] { background: var(--ok-100); color: #0b6b4a; }
.turn-kicker[data-tone="request"] { background: var(--wait-100); color: #8a5a06; }
.turn-kicker[data-tone="decision"] { background: var(--blue-100); color: var(--brand-blue); }
.turn-kicker[data-tone="error"] { background: var(--red-100); color: #a10a33; }
.turn-kicker[data-tone="final"] { background: var(--brand-ink); color: #fff; }

.turn-body {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}
.turn.is-quiet .turn-body { color: var(--ink-2); font-size: 13.5px; }
.turn-note { margin-top: 6px; color: var(--muted); font-size: 13px; white-space: pre-wrap; }

.turn[data-side="user"] .turn-body {
  display: inline-block;
  padding: 10px 14px;
  border-radius: 14px 14px 14px 4px;
  background: var(--blue-50);
  color: var(--brand-ink);
}

.turn.is-final .turn-body {
  padding: 14px 16px;
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--blue-50), #fff 120%);
  box-shadow: inset 0 0 0 1px var(--blue-100);
}

.turn-files { margin-top: 10px; }

.turn-error { color: #a10a33; }

/* file chips (shared: request files, deliverables, composer attachments) */
.file-chips {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.file-chips > li { display: flex; max-width: 100%; min-width: 0; }
.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  min-width: 0;
  height: 34px;
  padding: 0 10px 0 8px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 13px;
  transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
}
a.file-chip:hover { text-decoration: none; border-color: var(--blue-200); background: var(--blue-50); box-shadow: var(--shadow-1); }
.file-chip .ext {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  display: grid;
  place-items: center;
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  background: var(--panel-2);
  color: var(--ink-2);
  flex: none;
}
.file-chip .ext[data-ext="xlsx"], .file-chip .ext[data-ext="xls"] { background: #e2f5ea; color: #0b6b4a; }
.file-chip .ext[data-ext="inc"], .file-chip .ext[data-ext="data"], .file-chip .ext[data-ext="sch"] { background: var(--blue-100); color: var(--brand-blue); }
.file-chip .ext[data-ext="diff"] { background: var(--wait-100); color: #8a5a06; }
.file-chip .ext[data-ext="dev"], .file-chip .ext[data-ext="cps3"], .file-chip .ext[data-ext="grdecl"] { background: var(--cyan-100); color: #026a8a; }
.file-chip .name { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 12.5px; }
.file-chip .size { color: var(--muted-2); font-size: 12px; white-space: nowrap; }
.file-chip .icon { color: var(--muted); }
a.file-chip:hover .icon { color: var(--brand-blue); }
.file-chip .remove {
  width: 22px;
  height: 22px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  display: grid;
  place-items: center;
}
.file-chip .remove:hover { background: var(--red-50); color: var(--brand-red); }

/* ------------------------------------------------------------------ HITL gate */
.gate-panel {
  flex: none;
  margin: 0 24px 0;
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: linear-gradient(180deg, #fff8ea, #fff);
  border: 1px solid #f3dfb8;
  border-bottom: 0;
  box-shadow: 0 -8px 24px -18px rgba(217, 122, 6, 0.4);
  max-width: calc(860px + 48px);
  width: calc(100% - 48px);
  align-self: center;
}
.gate-head {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  cursor: pointer;
  user-select: none;
}
.gate-head::-webkit-details-marker { display: none; }
.gate-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--wait);
  color: #fff;
}
.gate-preview { flex: 1; min-width: 0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #6b4600; }
.gate-meta { color: #a07a3a; font-size: 12.5px; white-space: nowrap; }
.gate-toggle { color: #a07a3a; transform: rotate(90deg); transition: transform var(--t-base) var(--ease); }
.gate-panel[open] .gate-toggle { transform: rotate(-90deg); }
.gate-panel[open] .gate-preview { display: none; }
.gate-body { padding: 0 16px 14px; }
.gate-reason { margin: 0 0 10px; color: #6b4600; font-size: 13.5px; }
.gate-questions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
.gate-question { padding-top: 10px; border-top: 1px dashed #f0dcb4; }
.gate-question:first-child { border-top: 0; padding-top: 0; }
.gate-question-text { margin: 0 0 8px; font-weight: 500; color: var(--ink); white-space: pre-wrap; }
.gate-options { display: flex; flex-wrap: wrap; gap: 8px; }
.gate-option {
  height: 32px;
  padding: 0 12px;
  border-radius: 999px;
  border: 1px solid #ecd8ac;
  background: #fff;
  color: var(--ink);
  font-size: 13px;
  transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
}
.gate-option:hover { border-color: var(--wait); background: #fff5e3; }
.gate-option.is-selected { border-color: var(--brand-blue); background: var(--blue-100); color: var(--brand-blue); font-weight: 500; }
.gate-option:active { transform: scale(0.98); }
.gate-note { margin: 6px 0 0; color: var(--muted); font-size: 12.5px; }

/* ------------------------------------------------------------------ composer */
.composer {
  flex: none;
  padding: 12px 24px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
  max-width: calc(860px + 48px);
  align-self: center;
}
.composer-files { padding: 0 4px; }

.composer-box {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: end;
  gap: 8px;
  padding: 8px 8px 8px 10px;
  border-radius: var(--r-lg);
  border: 1px solid var(--line);
  background: var(--paper);
  box-shadow: var(--shadow-2);
  transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
}
.composer-box:focus-within { border-color: var(--brand-cyan); box-shadow: var(--shadow-2), var(--ring); }
.composer-box.is-dragover { border-color: var(--brand-cyan); background: var(--cyan-100); }
.composer-attach { margin-bottom: 2px; }
.composer-box textarea {
  border: 0;
  resize: none;
  outline: none;
  background: transparent;
  padding: 8px 2px;
  min-height: 36px;
  max-height: 220px;
  line-height: 1.5;
  font-size: 14.5px;
  color: var(--ink);
}
.composer-box textarea::placeholder { color: var(--muted-2); }
.composer-actions { display: flex; align-items: center; gap: 8px; }
.composer-send { height: 34px; padding: 0 12px 0 14px; }
.composer-hint { margin: 0 6px; font-size: 12.5px; color: var(--brand-red); }
.composer-drop-hint { margin: 0 8px; font-size: 12px; color: var(--muted-2); }

.workspace.is-composing .view-toggle,
.workspace.is-composing .inspector-toggle { display: none; }

.composer-idle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 14px;
  border-radius: var(--r-md);
  background: var(--panel);
  box-shadow: inset 0 0 0 1px var(--line);
}
.composer-idle-text { font-size: 13px; color: var(--muted); flex: 1 1 220px; }
.composer-idle-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; }

.file-chip-more {
  border-style: dashed;
  color: var(--brand-blue);
  font-family: var(--font);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
}
.file-chip-more:hover { background: var(--blue-50); }

/* new-task composer */
.start-composer {
  position: absolute;
  inset: 0;
  overflow-y: auto;
  padding: 28px 24px 40px;
  background: var(--paper);
  display: block;
  max-width: none;
  animation: turn-in var(--t-base) var(--ease);
}
.start-composer > * { max-width: 680px; margin-left: auto; margin-right: auto; }
.start-head { margin-bottom: 20px; }
.start-head h2 { margin: 0 0 6px; font-size: 22px; font-weight: 600; letter-spacing: -0.015em; }
.start-head p { margin: 0; color: var(--muted); font-size: 14px; }

.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field > span { font-size: 13px; font-weight: 500; color: var(--ink-2); }
.field .optional { font-style: normal; font-weight: 400; color: var(--muted-2); margin-left: 6px; }
.field input, .field textarea, .field select {
  width: 100%;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: var(--paper);
  font-size: 14.5px;
  color: var(--ink);
  outline: none;
  transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
}
.field textarea { resize: vertical; min-height: 96px; line-height: 1.5; }
.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--brand-cyan); box-shadow: var(--ring); }
.field input::placeholder, .field textarea::placeholder { color: var(--muted-2); }

.dropzone {
  margin-bottom: 14px;
  padding: 22px 20px;
  border-radius: var(--r-lg);
  border: 1.5px dashed #c9d5e6;
  background: var(--panel);
  text-align: center;
  cursor: pointer;
  transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
}
.dropzone:hover, .dropzone:focus-visible { border-color: var(--brand-blue); background: var(--blue-50); }
.dropzone.is-dragover { border-color: var(--brand-cyan); background: var(--cyan-100); }
.dropzone-icon { width: 22px; height: 22px; color: var(--brand-blue); margin-bottom: 6px; }
.dropzone-title { margin: 0; font-weight: 500; color: var(--ink); }
.dropzone-hint { margin: 4px 0 0; font-size: 12.5px; color: var(--muted); }
.dropzone .file-chips { margin-top: 14px; justify-content: center; }

.start-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
.start-actions .composer-actions { margin-left: auto; }

/* ------------------------------------------------------------------ inspector */
.inspector {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow-y: auto;
  border-left: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.55);
  padding: 0 0 24px;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}
.inspector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 18px 8px 20px;
}
.inspector-head h2 { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.inspector-close { display: none; }

.panel-empty { margin: 8px 20px; color: var(--muted); font-size: 13.5px; line-height: 1.5; }

.results-groups { display: flex; flex-direction: column; gap: 8px; padding: 6px 12px 0; }

.result-group {
  padding: 12px 10px 12px;
  border-radius: var(--r-md);
  background: var(--paper);
  box-shadow: inset 0 0 0 1px var(--line);
  animation: turn-in var(--t-base) var(--ease);
}
.result-group-head { display: flex; align-items: center; gap: 10px; padding: 0 2px 8px; }
.result-group .avatar { width: 28px; height: 28px; border-radius: 9px; font-size: 11px; }
.result-group-title { font-weight: 600; font-size: 13.5px; line-height: 1.2; }
.result-group-sub { color: var(--muted); font-size: 12px; margin-top: 1px; }
.result-group-tone { margin-left: auto; }

.result-file {
  display: grid;
  grid-template-columns: 30px 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 8px 6px;
  border-radius: 9px;
  color: var(--ink);
  transition: background var(--t-fast) var(--ease);
}
.result-file:hover { background: var(--blue-50); text-decoration: none; }
.result-file .ext {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  background: var(--blue-100);
  color: var(--brand-blue);
}
.result-file .ext[data-ext="diff"] { background: var(--wait-100); color: #8a5a06; }
.result-file .ext[data-ext="xlsx"] { background: #e2f5ea; color: #0b6b4a; }
.result-file .ext[data-ext="txt"], .result-file .ext[data-ext="log"] { background: var(--panel-2); color: var(--ink-2); }
.result-file-copy { min-width: 0; }
.result-file-name { font-family: var(--mono); font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-file-meta { font-size: 12px; color: var(--muted); margin-top: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-file .icon { color: var(--muted-2); }
.result-file:hover .icon { color: var(--brand-blue); }

.diff-expander { margin: 14px 12px 0; }
.diff-expander summary {
  list-style: none;
  cursor: pointer;
  padding: 8px 10px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  gap: 8px;
}
.diff-expander summary::-webkit-details-marker { display: none; }
.diff-expander summary::before {
  content: "";
  width: 6px;
  height: 6px;
  border-right: 1.5px solid var(--muted);
  border-bottom: 1.5px solid var(--muted);
  transform: rotate(-45deg);
  transition: transform var(--t-fast) var(--ease);
  margin-left: 4px;
}
.diff-expander[open] summary::before { transform: rotate(45deg); }
.diff-expander summary:hover { background: var(--panel-2); }
.diff-body {
  margin: 6px 0 0;
  padding: 10px 12px 12px;
  border-radius: 10px;
  background: var(--paper);
  box-shadow: inset 0 0 0 1px var(--line);
  font-size: 13px;
  line-height: 1.5;
  max-height: 420px;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.diff-summary { margin: 0; color: var(--ink); }
.diff-row { display: flex; flex-direction: column; gap: 6px; }
.diff-label { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-2); }
.diff-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.diff-chip { font-family: var(--mono); font-size: 11.5px; padding: 2px 8px; border-radius: 6px; background: var(--blue-50); color: var(--brand-blue); }
.diff-note { margin: 0; color: var(--muted); font-size: 12.5px; }
.diff-edits { margin: 0; padding-left: 18px; color: var(--ink-2); font-size: 12.5px; display: flex; flex-direction: column; gap: 4px; }

.inputs-panel { margin: 18px 20px 0; }
.inputs-panel h3 { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.inputs-list { flex-direction: column; gap: 6px; }
.inputs-list .file-chip { width: 100%; }
.inputs-list .file-chip .name { flex: 1 1 auto; }
.inputs-list .file-chip .size { margin-left: auto; }

/* ------------------------------------------------------------------ schema */
.schema-view {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  outline: none;
  background:
    radial-gradient(circle at 1px 1px, rgba(0, 51, 160, 0.10) 1px, transparent 1.5px) 0 0 / 22px 22px,
    linear-gradient(180deg, #fbfdff, #f5f8fc);
}
.schema-canvas { flex: 1; min-height: 0; position: relative; padding: 20px 28px 8px; }
.schema-stage { position: absolute; inset: 20px 28px 8px; }
.schema-edges { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.schema-nodes { position: absolute; inset: 0; --node-w: 216px; --hub-w: 220px; --orch-w: 236px; --node-typo: 1; --cap-lines: 3; --talk-lines: 5; }

.schema-edge {
  fill: none;
  stroke: #c5d0e2;
  stroke-width: 1.5;
  stroke-linecap: round;
  transition: stroke var(--t-base) var(--ease), stroke-width var(--t-base) var(--ease), opacity var(--t-base) var(--ease);
  opacity: 0.85;
}
.schema-edge.is-done { stroke: var(--brand-blue); stroke-width: 1.8; }
.schema-edge.is-active {
  stroke: var(--brand-cyan);
  stroke-width: 2.4;
  stroke-dasharray: 6 10;
  animation: edge-flow 0.9s linear infinite;
  opacity: 1;
}
.schema-edge.is-failed { stroke: var(--brand-red); stroke-width: 2; }
@keyframes edge-flow { to { stroke-dashoffset: -16; } }

.schema-edge-glow { fill: none; stroke: var(--brand-cyan); stroke-width: 10; opacity: 0; stroke-linecap: round; transition: opacity var(--t-base) var(--ease); }
.schema-edge-glow.is-active { opacity: 0.16; }

.schema-node {
  position: absolute;
  transform: translate(-50%, -50%);
  width: var(--node-w, 216px);
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
  padding: 12px 14px 12px;
  border-radius: 14px;
  background: var(--paper);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-1);
  transition: box-shadow var(--t-base) var(--ease), border-color var(--t-base) var(--ease), transform var(--t-base) var(--ease), opacity var(--t-base) var(--ease);
  cursor: default;
}
.schema-node.is-idle { opacity: 0.62; }
.schema-node.is-active { border-color: var(--brand-cyan); box-shadow: 0 0 0 4px rgba(0, 184, 240, 0.14), var(--shadow-2); opacity: 1; }
.schema-node.is-done { border-color: var(--blue-200); opacity: 1; }
.schema-node.is-waiting { border-color: #f0d39c; box-shadow: 0 0 0 4px rgba(217, 122, 6, 0.10), var(--shadow-1); opacity: 1; }
.schema-node.is-failed { border-color: #ffb3c4; box-shadow: 0 0 0 4px rgba(249, 13, 75, 0.10), var(--shadow-1); opacity: 1; }
.schema-node.is-peekable { cursor: pointer; }
.schema-node.is-peekable:hover { transform: translate(-50%, -50%) translateY(-2px); box-shadow: var(--shadow-2); }

.schema-node-head {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  column-gap: 8px;
  row-gap: 6px;
  margin-bottom: 4px;
  min-width: 0;
  max-width: 100%;
}
.schema-node-head > div { min-width: 0; overflow: hidden; }
.schema-node .avatar { width: 26px; height: 26px; border-radius: 8px; font-size: 10.5px; flex: none; }
.schema-node-kicker { font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-2); line-height: 1.2; }
.schema-node-title { font-weight: 600; font-size: calc(13px * var(--node-typo, 1)); line-height: 1.25; color: var(--ink); overflow-wrap: anywhere; word-break: break-word; }
.schema-node-status {
  grid-column: 1 / -1;
  justify-self: start;
  margin-left: 0;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
  height: auto;
  min-height: 22px;
  padding: 3px 9px;
  line-height: 1.25;
  white-space: normal;
  overflow: hidden;
  text-overflow: clip;
  text-align: left;
}
.schema-node-caption {
  margin: 4px 0 0;
  font-size: calc(12px * var(--node-typo, 1));
  line-height: 1.4;
  color: var(--muted);
  overflow: hidden;
  overflow-wrap: anywhere;
  word-break: break-word;
  display: -webkit-box;
