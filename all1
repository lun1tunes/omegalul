  padding: 0.85rem clamp(1.25rem, 3vw, 4rem) 1rem;
  display: grid;
  gap: 0.65rem;
  flex: 0 0 auto;
  transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
  transform-origin: bottom center;
}
.composer[hidden] { display: none !important; }
.composer-top {
  display: flex;
  align-items: end;
  justify-content: flex-end;
  gap: 0.85rem;
  flex-wrap: wrap;
}
.composer-attach-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}
