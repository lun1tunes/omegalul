            title: fields.title,
            keywords: fields.keywords,
            topics: fields.topics,
            task_patterns: fields.task_patterns,
          }),
        },
      );
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showFlash(detailMessage(data, `Сохранение не удалось (${res.status})`));
        return { ok: false, saved: false };
