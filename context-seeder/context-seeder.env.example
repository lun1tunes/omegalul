# Optional direct PGVector seeder only. This file is NOT used by FastAPI or n8n.
POSTGRES_HOST=database.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n_context_writer
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=require

# OpenAI-compatible embeddings endpoint.
EMBEDDING_API_KEY=change-me
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RAG_TABLE_NAME=n8n_excel_agent_context
# true replaces only rows marked source=excel-agent-operating-guide.
REPLACE_EXISTING_CONTEXT=true
# Usually leave empty: native run reads ../n8n/rag automatically.
CONTEXT_DOCUMENTS_FILE=
