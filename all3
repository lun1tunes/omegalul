    const overclaim = await decideVerified(preparedExcel, falseFinish, { ...rejected, goal_parts: rejected.goal_parts.map((p) => ({ ...p, covered: true })), all_covered: true, unsupported_claims: ['прогнозный schedule обновлён'] });
