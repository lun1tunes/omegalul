"""Catalogue-driven decoder for lossless SCHEDULE baseline packages.

The decoder never embeds vendor field layouts. It expands the already-vetted
INCLUDE graph in execution order, tokenizes records losslessly enough to bind
them back to CST nodes, resolves exactly one approved schema variant, and
emits typed IR split at an explicit change boundary.
"""
from __future__ import annotations

import json

from schedule_lossless_runtime import SHA256_JS


def build_baseline_decoder_js(keywords: list[str]) -> str:
    allowed = json.dumps(keywords, ensure_ascii=False)
