    }
    return { first: () => ({ json: nodes[nodeName] }) };
  };
  const fn = new AsyncFunction('$json', '$', source(workflow, name));
  const result = await fn(json, lookup);
  assert(Array.isArray(result) && result.length === 1 && result[0].json);
