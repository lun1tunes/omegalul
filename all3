        "jsCode": "const prepared = $('Prepare status lookup').first().json || {};\nconst preparedItem = $('Prepare status lookup').first();\nconst statusResponse = $input.first().json || {};\nconst formAction = String(prepared.form_action || 'status').toLowerCase();\nconst humanResponse = String(prepared.human_response || '').trim();\nconst requestedBy = String(prepared.requested_by || 'anonymous').trim();\nconst gate = statusResponse.human_gate && typeof statusResponse.human_gate === 'object' ? statusResponse.human_gate : null;\nconst awaiting = statusResponse.status === 'awaiting_human' && gate && gate.gate_id;\nconst mutating = ['reply', 'approve', 'reject', 'cancel'].includes(formAction);\nconst binary = preparedItem.binary && typeof preparedItem.binary === 'object' ? preparedItem.binary : null;\nconst binaryKeys = binary ? Object.keys(binary) : (Array.isArray(prepared.hitl_binary_keys) ? prepared.hitl_binary_keys : []);\nlet shouldResume = false;\nlet blockReason = '';\nif (prepared.input_valid === false) {\n  blockReason = prepared.message || 'Invalid form input.';\n} else if (!mutating) {\n  blockReason = 'status_only';\n} else if (!awaiting) {\n  blockReason = statusResponse.status === 'not_found'\n    ? 'Task not found. Check Task ID.'\n    : `Task status is ${statusResponse.status || 'unknown'}; there is no open human_gate to answer.`;\n} else if (formAction === 'reply' && !humanResponse && !binaryKeys.length) {\n  blockReason = 'human_response is required for reply (or attach HITL files with a short reply).';\n} else if (!requestedBy || requestedBy === 'anonymous') {\n  blockReason = 'requested_by must be a named accountable engineering identity.';\n} else {\n  shouldResume = true;\n}\nconst expectedVersion = Number(gate?.expected_version ?? statusResponse.version);\nif (shouldResume && (!Number.isInteger(expectedVersion) || expectedVersion < 1 || !gate?.gate_id)) {\n  shouldResume = false;\n  blockReason = 'Open human_gate is missing integer expected_ve