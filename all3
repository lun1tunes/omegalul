  asks=asks.filter(a=>{
    const k=a.text;
    if(!k||seen.has(k)) return false;
    seen.add(k);
    return true;
  }).slice(0,20);
  if(!asks.length) asks=[{id:'hitl_needed', text:HITL_GENERIC_ITEM, question:HITL_GENERIC_ITEM, required:true}];
