  const amb = materialize({
    uploads: [
      { fileName: 'a.inc', text: "INCLUDE\n'x.inc' /\n/\n" },
      { fileName: 'b.inc', text: "INCLUDE\n'y.inc' /\n/\n" },
      { fileName: 'x.inc', text: '-- x\n' },
      { fileName: 'y.inc', text: '-- y\n' },
    ],
  });
