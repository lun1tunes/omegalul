    asks=gaps.map((g,i)=>toAsk({...g, code:g.code||'EVIDENCE_GAP'}, i, 'schedule_gap'));
  } else {
    asks=unique.map((f,i)=>toAsk({...f, text:f.message}, i, 'schedule_finding'));
