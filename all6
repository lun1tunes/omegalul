def wait_control_plane_webhook(env: dict[str, str], attempts: int = 60, *, required: bool = True) -> bool:
    """Activity cannot boot until production /webhook/mas-control-plane is registered."""
    port = env.get("N8N_HOST_PORT", "15678")
