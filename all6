        if "artifact_id" in node or isinstance(node.get("filename"), str):
            aid = str(node.get("artifact_id") or key)
            out[aid] = node
            return
        for k, v in node.items():
            walk(v, str(k))

    walk(arts)
    return out


def print_timeline(evs: list[dict[str, Any]]) -> None:
