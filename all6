def wait_url(url: str, attempts: int = 90) -> None:
    """Host-side health wait — avoids depending on wget inside images."""
    for i in range(attempts):
        try:
            with urllib.request.urlopen(url, timeout=3) as resp:
                if int(resp.status) == 200:
                    return
        except Exception:
            pass
        time.sleep(1)
