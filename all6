                  ],
                  "task_patterns": [
                    "задать NETBALAN",
                    "допуск балансирования NETWORK",
                    "итерации сети",
                    "сходимость давления узлов",
                    "погрешность штуцера группы"
                  ],
                  "simulator_family": [
                    "E100",
