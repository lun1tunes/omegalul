Payload = {}; }\nagentPayload.preflight_tables = tables;\nagentPayload.selected_table = selected;\nagentPayload.selected_table_authoritative = selectedTableAuthoritative;\nagentPayload.suggested_select = Array.isArray(match.suggested_select) ? match.suggested_select : [];\nagentPayload.match_reason = match.reason || null;\nif (selectedTableAuthoritative) {\n  agentPayload.instruction = `${agentPayload.instruction || ''} Selected table is authoritative because the request named an explicit table/sheet selector. Call describe_table on that tbl_, then save_agent_plan, then immediately query_table. Do not call detect_tables. Never stop after save_agent_plan.`.trim();\n} else if (selected && !needsClarification) {\n  agentPayload.instruction = `${agentPayload.instruction || ''} Preflight ranked a recommended table (advisory) plus candidates in preflight_tables. You may describe_table another candidate if the request names a different sheet/table. Do not call detect_tables. Deterministic preflight still owns true ambiguity.`.trim();\n} else {\n  agentPayload.instruction = `${agentPayload.instruction || ''} Compact preflight candidates are advisory ranked matches. Do not call detect_tables again. Deterministic preflight owns remaining table/sheet/column ambiguity.`.trim();\n}\nconst question = columnCandidates.length\n  ? `The selected table has multiple matching columns (${labels.join('; ')}). Which column(s) should be extracted? Reply with the exact column names.`\n  : (sheetCandidates.length\n    ? `The workbook has multiple matching sheets (${labels.join('; ')}). Which sheet/table should be extracted? Reply with the sheet name, range, or distinctive columns.`\n    : `The workbook contains multiple independent tables (${labels.join('; ')}). Which table should be extracted? Reply with its sheet, columns or range.`);\nreturn [{ json: {\n  ...prepared,\n  agent_input: JSON.stringify(agentPayload),\n  selected_table_authoritative: selectedTableAuthoritative,\n  preflight_ne