# tNav Cluster Agent FastAPI. Скопируйте в tnav-cluster.env и подставьте свои значения.
# Поле: 0.0.0.0, если до сервиса должен достучаться корпоративный n8n. lab: контейнер слушает 0.0.0.0 сам.
TNAV_CLUSTER_HOST=127.0.0.1
TNAV_CLUSTER_PORT=8400
# Activity на этой рабочей станции; задача обычно приносит inputs.activity_base_url, это резерв.
ACTIVITY_BASE_URL=http://127.0.0.1:8200

# --- доступ к гидродинамическому кластеру -------------------------------------------------------
# ssh — работа на кластере; local — песочница на этой машине (лаборатория, мок кластера).
TNAV_TRANSPORT=ssh
TNAV_SSH_HOST=cluster.example.local
TNAV_SSH_PORT=22
TNAV_SSH_USER=re_engineer
TNAV_SSH_PASSWORD=
# Вместо пароля можно указать приватный ключ (и парольную фразу к нему):
# TNAV_SSH_KEY_PATH=C:\Users\me\.ssh\id_ed25519
# TNAV_SSH_KEY_PASSPHRASE=
# strict — требовать запись в known_hosts; по умолчанию ключ хоста принимается при первом подключении.
# TNAV_SSH_STRICT_HOST_KEY=0
# TNAV_SSH_KNOWN_HOSTS=C:\Users\me\.ssh\known_hosts

# --- единственный рабочий каталог на кластере ---------------------------------------------------
# Агент работает ТОЛЬКО внутри этого каталога: все пути моделей — относительно него, выход наружу запрещён.
TNAV_CLUSTER_ROOT=/data/models

# --- команда расчёта ----------------------------------------------------------------------------
# «<путь к tNavigator-con на кластере> <ваши опции> {model}». {model} подставляет агент — путь к .data файлу.
# Опции — мануал tNavigator, раздел 8.1: --cpu-num, --mpi-num, --log-lang, --dump-res, --max-calc-time.
TNAV_CLI_COMMAND=/opt/tNavigator/tNavigator-con --cpu-num=8 --log-lang=ru --dump-res {model}
# Каталог, куда tNavigator кладёт .log/.err/.end/.lock рядом с моделью (мануал 9.1.1).
TNAV_RESULTS_DIRNAME=RESULTS

# --- наблюдение за расчётом ---------------------------------------------------------------------
# Как часто опрашивать кластер и как часто писать строку в ленту инженеру (секунды).
TNAV_POLL_SECONDS=60
TNAV_PROGRESS_EVERY_S=900
# Предохранитель: дольше этого агент не ждёт (расчёт на кластере продолжается).
TNAV_MAX_WAIT_HOURS=72
# Таймаут короткой команды (ls/grep/cp) и глубина поиска моделей под корнем.
TNAV_COMMAND_TIMEOUT_S=120
TNAV_SCAN_DEPTH=4
# TNAV_SESSIONS_DIR=data/sessions

