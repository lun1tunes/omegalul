                  "knowledge_type": "keyword_instruction",
                  "knowledge_id": "netbalan-network-balance-v1",
                  "revision": "1",
                  "title": "NETBALAN — параметры балансирования NETWORK",
                  "keywords": [
                    "NETBALAN"
                  ],
                  "topics": [
                    "балансирование сети",
                    "NETBALAN",
                    "NETWORK solver",
                    "давление узлов",
