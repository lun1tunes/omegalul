ld\": \"MAX_GOR\", \"min\": 0}, {\"field\": \"MAX_WGR\", \"min\": 0}]}}, {\"schema_id\": \"expert:WECON:min_orat_lrat\", \"schema_revision\": \"1\", \"keyword\": \"WECON\", \"variant\": \"min_orat_lrat\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.77 / 1906-1909\", \"heading\": \"WECON\", \"source_hash\": \"sha256:c3bd6db93216ac2c35a0425f4c7d578a1ad6dc5f3215242347963c9d3d78fba7\"}, \"parser\": {\"token_width\": 14, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"WELL\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"MIN_ORAT\", \"position\": 2, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MIN_GRAT\", \"position\": 3, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MAX_WCT\", \"position\": 4, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MAX_GOR\", \"position\": 5, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MAX_WGR\", \"position\": 6, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"ACTION\", \"position\": 7, \"type\": \"string\", \"required\": true, \"enum\": [\"NONE\", \"CON\", \"CON+\", \"+CON\", \"WELL\"]}, {\"name\": \"END_RUN\", \"position\": 8, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"enum\": [\"YES\", \"NO\"]}, {\"name\": \"FOLLOWON_WELL\", \"position\": 9, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"quote\": \"single\"}, {\"name\": \"MIN_QUANTITY\", \"position\": 10, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"enum\": [\"RATE\", \"POTN\"]}, {\"name\": \"MAX_WCT2\", \"position\": 11, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"ACTION2\", \"position\": 12, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"enum\": [\"NONE\", \"CON\", \"CON+\", \"+CON\", \"WELL\", \"LAST\", \"RED\"]}, {\"name\": \"MAX_GLR\", \"position\": 13, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MIN_LRAT\", \"position\": 14, \"type\": \"number\", \"required\": true}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"references\": [{\"entity_type\": \"well\", \"id_field\": \"WELL\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"WELSPECS\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}], \"state_assignments\": [{\"namespace\": \"well-economic\", \"entity_type\": \"well\", \"entity_field\": \"WELL\", \"key_fields\": [\"WELL\"], \"value_fields\": [\"MIN_ORAT\", \"MIN_GRAT\", \"MAX_WCT\", \"ACTION\", \"MIN_LRAT\", \"FOLLOWON_WELL\"]}], \"numeric_constraints\": [{\"field\": \"MIN_ORAT\", \"min\": 0}, {\"field\": \"MIN_GRAT\", \"min\": 0}, {\"field\": \"MAX_WCT\", \"min\": 0}, {\"field\": \"MIN_LRAT\", \"min\": 0}, {\"field\": \"MAX_GLR\", \"min\": 0}, {\"field\": \"MAX_WCT2\", \"min\": 0}]}}]}}, {\"contract\": \"schedule_knowledge_block\", \"contract_version\": \"1.0\", \"target_base\": \"schedule_mvp\", \"knowledge_type\": \"keyword_instruction\", \"knowledge_id\": \"wtest-reopen-policy-v1\", \"revision\": \"1\", \"title\": \"WTEST — проверка и переоткрытие закрытых скважин\", \"keywords\": [\"WTEST\"], \"topics\": [\"проверка закрытых скважин\", \"WTEST\", \"переоткрытие\", \"физическое закрытие P\", \"экономическое E WECON\", \"group shut G\"], \"task_patterns\": [\"задать WTEST\", \"проверить закрытую скважину\", \"переоткрытие после BHP\", \"WTEST после WECON\", \"интервал проверки скважины\", \"постепенный запуск STARTUP\"], \"simulator_family\": [\"E100\", \"E300\", \"tNavigator\"], \"status\": \"active\", \"author\": \"department-hydrodynamic-expert\", \"access_scope\": \"petroleum-engineering\", \"text\": \"WTEST — периодическая проверка закрытых скважин на возможность переоткрытия.\\n\\nНазначение. WTEST задаёт, как часто и при каком типе закрытия симулятор пытается снова открыть скважину (или её перфорации). Форматы: tN, E1, E3. Секция: SCHEDULE. Это не WECON (экономические пределы), не WCONPROD (целевой контроль), не ручной OPEN в статусе. Совместно с WECON анализируйте shut/reopen циклы.\\n\\nКогда применять. Скважина может быть закрыта по BHP/THP, экономике или group/FIELD limits, и нужна политика перепроверки. После WELSPECS. Для reason E обычно уже есть WECON (или CECON/WECONINJ — вне allowlist).\\n\\nRecord layout. Keyword WTEST, записи `/`, блок — отдельный `/`. WELL или имя WLIST (`*…`); список объявить WLIST ранее. Сырая маска без WLIST → needs_input.\\n\\nПоля (§12.20.188):\\n\\n1. WELL — имя скважины.\\n2. INTERVAL — интервал проверки (day). Первая проверка — в начале шага, начавшегося спустя INTERVAL после закрытия; далее — каждый шаг после INTERVAL с прошлой проверки.\\n3. REASON — строка условий закрытия, при которых разрешена проверка. tNavigator смотрит, содержит ли строка символы:\\n   - P — закрыта по физической причине (лимит BHP/THP). При успехе — открыть скважину.\\n   - E — закрыта по экономике (WECON / CECON / WECONINJ). Если есть открытые перфорации — скважина остаётся открытой при выполнении WECON (закрытые перфы не открываются заново). Если все перфы закрыты — проверка каждой авто-закрытой перфорации по WCT/GOR/WGR; ручные закрытия не трогаются; скважина открывается, если открылась хотя бы одна перф.\\n   - G — закрыта по GROUP/FIELD (GECON или семейство GCON****). Открывается без изолированной проверки; если group limits снова нарушены — действие в конце шага. Авто-закрытые перфы открываются, если не было открытых.\\n   Можно комбинировать символы в одной строке (напр. PE), если факт требует несколько причин.\\n4. NTEST — число проверок (integer). После NTEST проверок (любой исход) проверка прекращается, пока снова не зададите WTEST. Default: 0 = без лимита.\\n5. STARTUP — время запуска (day). После успешного reopen efficiency умножается на (T−T0)/STARTUP, пока T−T0 < STARTUP (постепенный ввод). Default: 0 = мгновенно. Коэффициент эксплуатации (WEFAC и т.п.) имеет приоритет над STARTUP.\\n\\nКанон render.\\n- `physical` — WELL INTERVAL REASON=P [NTEST STARTUP].\\n- `economic` — WELL INTERVAL REASON=E [NTEST STARTUP] (обычно рядом с WECON).\\n- `group` — WELL INTERVAL REASON=G [NTEST STARTUP].\\n- `full` — все пять полей явно (паттерн Well1 120 P 20 10).\\nINTERVAL > 0. Не копируйте Well1/120/20/10 без фактов. Не WLIST.\\n\\nIR / semantics.\\n- period=ANY; clock.uses_current=true.\\n- references: well WELL required.\\n- prerequisites: WELSPECS scope=ENTITY по WELL.\\n- state_assignments: namespace well-test; key WELL; value_fields INTERVAL, REASON, NTEST, STARTUP.\\n- numeric_constraints: INTERVAL min_exclusive 0; NTEST min 0; STARTUP min 0.\\n\\nСвязанные keywords (не эмитьте без scope).\\n- WECON — economic shut; reason E.\\n- WCONPROD / статус OPEN|SHUT|STOP — контроль vs тест.\\n- GECON / GCON* — reason G (многие вне allowlist → needs_input на детали group shut).\\n- WEFAC — приоритет над STARTUP ramp.\\n\\nВалидация.\\n- REASON содержит хотя бы один из P/E/G (и только допустимые символы политики MVP: P, E, G и их комбинации).\\n- INTERVAL конечный и > 0.\\n- Не задавать WTEST «на открытую» без сценария будущего закрытия — бессмысленно, но не ошибка грамматики; факт должен объяснять зачем.\\n- Избегать пары WECON ACTION=WELL + WTEST E с нулевым INTERVAL без понимания цикла.\\n\\nАнтипаттерны.\\n- Путать WTEST с ручным OPEN в WCONPROD.\\n- REASON без P/E/G.\\n- INTERVAL в месяцах без перевода в days.\\n- Выдумать NTEST/STARTUP.\\n\\nНехватка факта → needs_input: нет WELL; нет INTERVAL; нет REASON; нужен E без WECON-политики; конфликт baseline test/econ без REVISE target.\\n\\nКарточка самодостаточна: renderer использует только schema_catalogue этой записи и выбранный variant.\", \"examples\": [{\"title\": \"Физическое закрытие — канон мануала\", \"task\": \"Well1: проверка каждые 120 дней при закрытии P, 20 попыток, ramp 10 дней.\", \"schedule_text\": \"WTEST\\nWell1 120 P 20 10/\\n/\\n\", \"explanation\": \"§12.20.188 с. 2147. Variant full / physical. Учебные имена и числа.\"}, {\"title\": \"Экономика + WECON\", \"task\": \"P01 проверять каждые 90 дней после economic shut (E), без лимита попыток.\", \"schedule_text\": \"WTEST\\n  'P01' 90 E /\\n/\\n\", \"explanation\": \"Variant economic. NTEST/STARTUP default (0). WECON для P01 должен быть в пакете/фактах.\"}, {\"title\": \"Group/FIELD shut\", \"task\": \"P01: INTERVAL=30 дней, REASON=G.\", \"schedule_text\": \"WTEST\\n  'P01' 30 G /\\n/\\n\", \"explanation\": \"Variant group. Открытие без изолированной проверки условий скважины.\"}], \"schema_catalogue\": {\"contract\": \"schedule_schema_catalogue\", \"contract_version\": \"1.0\", \"catalogue_ref\": \"catalogue://tnavigator/22.2/wtest-reopen-policy-v1\", \"catalogue_hash\": \"sha256:a65b646b71413d97be337e5536f205694b22ad8e642e8cf8da26f4d9b301042d\", \"source_hash\": \"sha256:c8054c61eb6fdcd1b3907bb426a274878cff094bb5c832c34aed1eddfaaef33c\", \"access_scope\": \"petroleum-engineering\", \"simulator_profile\": {\"vendor\": \"Rock Flow Dynamics\", \"simulator\": \"tNavigator\", \"version\": \"22.2\", \"unit_system\": \"METRIC\"}, \"approved\": true, \"approved_by\": \"department-hydrodynamic-expert\", \"author\": \"department-hydrodynamic-expert\", \"approval_gate_id\": \"expert:wtest-reopen-policy-v1:1\", \"schemas\": [{\"schema_id\": \"expert:WTEST:physical\", \"schema_revision\": \"1\", \"keyword\": \"WTEST\", \"variant\": \"physical\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.188 / 2146-2147\", \"heading\": \"WTEST\", \"source_hash\": \"sha256:c8054c61eb6f