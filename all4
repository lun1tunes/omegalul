        "jsCode": "\nfunction fromNode(name){\n  try{\n    const n=$(name);\n    if(n&&n.item&&n.item.json) return n.item.json;\n    if(n&&typeof n.last==='function'){const x=n.last(); if(x&&x.json) return x.json;}\n    if(n&&typeof n.first==='function'){const x=n.first(); if(x&&x.json) return x.json;}\n  }catch(e){}\n  return {};\n}\nfunction obj(v){return v&&typeof v==='object'&&!Array.isArray(v);}\nfunction stripThink(text){return String(text||'').replace(/<think>[\\s\\S]*?<\\/think>/gi,' ').replace(/\\s+/g,' ').trim();}\nfunction clip(text,n){const s=String(text||''); return s.length<=n?s:s.slice(0,n-1)+'…';}\nfunction parseArgs(raw){\n  if(obj(raw)) return raw;\n  const s=String(raw||'').trim();\n  if(!s) return {};\n  try{const p=JSON.parse(s); return obj(p)?p:{};}catch(e){return {};}\n}\nfunction looksMachine(text){\n  const s=String(text||'');\n  if(!s.trim()) return false;\n  return /[a-z]+_[a-z_]+|[a-z_]+=[a-z0-9]+|[{}\\[\\]]|\\w\\|\\w/.test(s)||/\\bbaseline\\b/i.test(s)||!/[А-Яа-яЁё]{3,}/.test(s);\n}\nfunction loopRouteForPending(pending, over){\n  const list=Array.isArray(pending)?pending:[];\n  if(list.length){\n    const name=String((list[0]&&list[0].name)||'');\n    return name==='retrieve_knowledge'?'retrieve':'tool';\n  }\n  return over?'done':'chat';\n}\nfunction toolTransportCode(http){\n  if(!http||typeof http.ok==='boolean') return '';\n  const err=obj(http.error)?http.error:(typeof http.error==='string'?{message:http.error}:null);\n  const status=Number(http.statusCode||http.status||(err&&err.status)||0);\n  const blob=String((err&&(err.httpCode||err.code||err.message||err.description))||'').toLowerCase();\n  if(/econnrefused|enotfound|etimedout|econnreset|ehostunreach|socket hang|connection|offline|unreachable/.test(blob)) return 'service_unreachable';\n  if(status>=500) return 'service_unreachable';\n  if(err&&(status===0||!status)&&!http.choices) return 'service_unreachable';\n  if(err||status>=400) return 'tool_http_failed';\n  return '';\n}\nfunction parseChatExtra(cfg){\n  const raw=cfg&&cfg.chat_extra_params;\n  let parsed={};\n  if(raw&&typeof raw==='object'&&!Array.isArray(raw)) parsed=raw;\n  else {\n    const s=String(raw||'').trim();\n    if(s){\n      try{const p=JSON.parse(s); if(p&&typeof p==='object'&&!Array.isArray(p)) parsed=p;}catch(e){parsed={};}\n    }\n  }\n  const out={...parsed};\n  delete out.messages;\n  delete out.tools;\n  delete out.tool_choice;\n  return out;\n}\nfunction previewChatMessages(msgs, fromIdx){\n  const CONTENT=600;\n  const KEEP=10;\n  const list=Array.isArray(msgs)?msgs:[];\n  const slim=(m)=>{\n    const raw=m&&typeof m==='object'&&!Array.isArray(m)?m:{};\n    const c=raw.content;\n    let text='';\n    if(typeof c==='string') text=c;\n    else if(c==null) text='';\n    else { try{text=JSON.stringify(c);}catch(e){text=String(c);} }\n    if(text.length>CONTENT) text=text.slice(0,CONTENT-1)+'…';\n    const out={role:String(raw.role||''),content:text};\n    if(raw.tool_call_id) out.tool_call_id=String(raw.tool_call_id);\n    if(Array.isArray(raw.tool_calls)&&raw.tool_calls.length) out.tool_calls=raw.tool_calls.length;\n    return out;\n  };\n  const all=list.map(slim);\n  const start=Math.max(0,Number(fromIdx)||0);\n  let picked=start>0?all.slice(start):all.slice();\n  let omitted=0;\n  if(start>0&&all[0]&&all[0].role==='system'){\n    omitted=Math.max(0,start-1);\n    picked=[all[0],...(omitted?[{role:'omitted',count:omitted}]:[]),...picked];\n  }\n  if(picked.length>KEEP){\n    omitted += picked.length-KEEP;\n    picked=[picked[0],{role:'omitted',count:omitted},...picked.slice(-(KEEP-2))];\n  }\n  const preview={messages:picked};\n  if(omitted) preview.omitted=omitted;\n  return preview;\n}\nconst SYSTEM=\"Ты — решатель агента tNav Cluster Agent. Ты работаешь с моделями на гидродинамическом кластере: разбираешь модель, собираешь её новую версию с новым файлом расписания и запускаешь расчёт. Считают и правят файлы инструменты; ты сам ничего не вычисляешь, строки расписания не пишешь и команды кластера не придумываешь.\\n\\nsession_id привязан workflow: никогда не передавай session_id и обёртку args/input.\\n\\nКакой инструмент когда:\\n- Нужно понять устройство модели (её секции, подключённые файлы, какой файл расписания основной) → inspect_model с путём к входному файлу модели. Путь бери из списка моделей, который пришёл при открытии сессии.\\n- В списке нет нужной модели или путь сомнительный → list_models один раз, потом inspect_model.\\n- Задача просит применить новое расписание, собрать новую версию модели, подготовить прогнозный вариант → prepare_model_version. Инструмент сам скопирует входной файл модели, положит рядом новый файл расписания и перепишет подключение в копии.\\n- Задача просит посчитать, запустить расчёт, посчитать на кластере → start_calculation. После ответа in_progress расчёт идёт сам, результат придёт позже: больше инструменты не вызывай, STOP.\\n- Инженер спрашивает, как идёт уже запущенный расчёт → check_calculation.\\n- Из задачи непонятно, какую модель считать или какое расписание применять, и подсказок в списке нет → ask_engineer одним вопросом обычной русской фразой.\\n\\nПорядок для задачи «новая версия и расчёт»: inspect_model → prepare_model_version → start_calculation. Больше четырёх вызовов инструментов не нужно.\\n\\nОтветы инструментов:\\n- ok:false, code:model_not_chosen или model_not_found — это тебе: возьми путь из available_models или спроси инженера через ask_engineer.\\n- ok:false, code:schedule_file_missing, schedule_file_ambiguous, schedule_file_without_dates — выбери другой файл из available_files или сообщи инженеру, что расписание не передано.\\n- ok:false, code:version_not_created или run_not_started — прочитай message: чаще всего мешает уже существующее имя версии или запущенный расчёт.\\n- ok:false, code:question_not_human — переформулируй вопрос прозой и вызови ask_engineer снова.\\n- status prepared — версия собрана; status in_progress, completed, needs_input — результат зафиксирован, STOP.\\n\\nНичего не удаляй и не предлагай удалять: инструменты умеют только копировать, создавать и переименовывать. Пути к файлам и имена файлов в ответе инженеру не вставляй — пиши, что сделано: собрал новую версию модели, запустил расчёт, расчёт завершён за столько-то. Заверши одним коротким фактическим предложением по-русски.\\n\";\nconst TOOLS=[{\"type\": \"function\", \"function\": {\"name\": \"list_models\", \"description\": \"Показать входные файлы моделей в рабочем каталоге кластера.\", \"parameters\": {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"inspect_model\", \"description\": \"Разобрать модель: секции входного файла, подключённые файлы, основной файл расписания (в нём больше всего дат).\", \"parameters\": {\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\", \"description\": \"Путь к входному файлу модели относительно рабочего каталога кластера\"}}, \"additionalProperties\": true, \"required\": [\"model\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"prepare_model_version\", \"description\": \"Собрать новую версию модели: новый файл расписания рядом со старым, копия входного файла модели с новым подключением.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"version_name\": {\"type\": \"string\", \"description\": \"Короткое латинское имя версии для имён файлов, например prognoz_2027\"}, \"model\": {\"type\": \"string\", \"description\": \"Путь к входному файлу модели; пусто — разобранная модель\"}, \"schedule_artifact_id\": {\"type\": \"string\", \"description\": \"Какой файл расписания из задачи применить; пусто — единственный\"}}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"start_calculation\", \"description\": \"Запустить расчёт модели на кластере. Сразу возвращает in_progress; результат придёт позже через Activity.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\", \"description\": \"Путь к входному файлу модели; пусто — собранная новая версия\"}}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"check_calculation\", \"description\": \"Состояние запущенного расчёта: идёт, завершился или упал, сколько шагов пройдено и сколько осталось.\", \"parameters\": {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"ask_engineer\", \"description\": \"Спросить инженера одним вопросом по-русски, когда непонятно, какую модель считать или какое расписание применять. Не для ошибок вызова инструментов.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"question\": {\"type\": \"string\", \"description\": \"Обычная русская фраза без имён полей, путей и JSON\"}, \"options\": {\"type\": \"string\", \"description\": \"Варианты через точку с запятой, как их видит инженер; пусто — свободный ответ\"}}, \"additionalProperties\": true, \"required\": [\"question\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"retrieve_knowledge\", \"description\": \"Найти карточки в базе знаний по запросу. Вызови, когда в текущем срезе нет инструкции по нужному keyword или протоколу — особенно перед первым apply_dataset / apply_operations / extract_table по ним. keywords — имена keyword через запятую.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"description\": \"Поисковый запрос (русская фраза или имена keyword)\"}, \"keywords\": {\"type\": \"string\", \"description\": \"Необязательно: семейства keyword через запятую\"}}, \"required\": [\"query\"]}}}];\nconst THINKING_OFF={\"reasoning\": {\"enabled\": false}, \"enable_thinking\": false, \"chat_template_kwargs\": {\"enable_thinking\": false}};\nconst SAMPLING={\"temperature\": 0.7, \"top_p\": 0.8, \"top_k\": 20, \"presence_penalty\": 1.5};\nconst DEFAULT_CHAT_MODEL=\"qwen/qwen3.6-27b\";\nconst MAX_ITER=8;\nconst prev=$json||{};\nlet cfg={};\ntry{cfg=$('Runtime configuration').first().json||{};}catch(e){cfg={}}\nconst model=String(cfg.chat_model||'').trim()||DEFAULT_CHAT_MODEL;\nconst base=String(cfg.chat_base_url||'').replace(/[/]+$/,'');\nconst chat_url=base?base+'/chat/completions':'';\nlet messages=Array.isArray(prev.messages)?prev.messages:[];\nif(!messages.length){\n  messages=[{role:'system',content:SYSTEM},{role:'user',content:String(prev.planner_input||prev.agent_input||'')}];\n}\nconst extra=parseChatExtra(cfg);\nconst chat_request={model,...SAMPLING,...THINKING_OFF,messages,tools:TOOLS,tool_choice:'auto',...extra};\nreturn [{json:{...prev,messages,chat_request,chat_url,max_iterations:MAX_ITER,iteration:Number(prev.iteration||0)}}];\n"
