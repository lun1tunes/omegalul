, \"accepts_files\": {\"type\": \"string\", \"description\": \"Какие файлы принимаются, через запятую: xlsx, .inc\"}}, \"additionalProperties\": true, \"required\": [\"question\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"apply_operations\", \"description\": \"Применить operations. JSON-массив: [{\\\"keyword\\\":\\\"WCONPROD\\\",\\\"operation\\\":\\\"MODIFY\\\",\\\"fields\\\":{...}}].\", \"parameters\": {\"type\": \"object\", \"properties\": {\"operations\": {\"type\": \"string\", \"description\": \"Массив {keyword, operation, fields}. Не объект с ключами 0,1,2. Передай JSON-строкой.\"}}, \"additionalProperties\": true, \"required\": [\"operations\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"render_ir\", \"description\": \"Собрать текст keyword по schema_catalogue: ir_events[{event_id,operation,keyword,variant,fields,provenance}]. Не пиши .INC руками.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"mode\": {\"type\": \"string\", \"description\": \"CREATE или REVISE\"}, \"ir_events\": {\"type\": \"string\", \"description\": \"Массив IR-событий с fields по get_keyword.details.parameters Передай JSON-строкой.\"}}, \"additionalProperties\": true, \"required\": [\"ir_events\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"build_schedule\", \"description\": \"Собрать текущий working SCHEDULE, если apply уже отработал. Не вызывай вместо commissioning/group_rebind.\", \"parameters\": {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"validate_result\", \"description\": \"Проверить текущий working text: findings без полного файла.\", \"parameters\": {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": true}}}, {\"type\": \"function\", \"function\": {\"name\": \"retrieve_knowledge\", \"description\": \"Найти карточки в базе знаний по запросу. Вызови, когда в текущем срезе нет инструкции по нужному keyword или протоколу — особенно перед первым apply_dataset / apply_operations / extract_table по ним. keywords — имена keyword через запятую.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"description\": \"Поисковый запрос (русская фраза или имена keyword)\"}, \"keywords\": {\"type\": \"string\", \"description\": \"Необязательно: семейства keyword через запятую\"}}, \"required\": [\"query\"]}}}];\nconst THINKING_OFF={\"reasoning\": {\"enabled\": false}, \"enable_thinking\": false, \"chat_template_kwargs\": {\"enable_thinking\": false}};\nconst SAMPLING={\"temperature\": 0.7, \"top_p\": 0.8, \"top_k\": 20, \"presence_penalty\": 1.5};\nconst DEFAULT_CHAT_MODEL=\"qwen/qwen3.6-27b\";\nconst MAX_ITER=8;\nconst prev=$json||{};\nlet cfg={};\ntry{cfg=$('Runtime configuration').first().json||{};}catch(e){cfg={}}\nconst model=String(cfg.chat_model||'').trim()||DEFAULT_CHAT_MODEL;\nconst base=String(cfg.chat_base_url||'').replace(/[/]+$/,'');\nconst chat_url=base?base+'/chat/completions':'';\nlet messages=Array.isArray(prev.messages)?prev.messages:[];\nif(!messages.length){\n  messages=[{role:'system',content:SYSTEM},{role:'user',content:String(prev.planner_input||prev.agent_input||'')}];\n}\nconst extra=parseChatExtra(cfg);\nconst chat_request={model,...SAMPLING,...THINKING_OFF,messages,tools:TOOLS,tool_choice:'auto',...extra};\nreturn [{json:{...prev,messages,chat_request,chat_url,max_iterations:MAX_ITER,iteration:Number(prev.iteration||0)}}];\n"
