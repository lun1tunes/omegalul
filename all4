                  ],
                  "task_patterns": [
                    "задать WTEST",
                    "проверить закрытую скважину",
                    "переоткрытие после BHP",
                    "WTEST после WECON",
                    "интервал проверки скважины",
                    "постепенный запуск STARTUP"
                  ],
                  "simulator_family": [
                    "E100",
