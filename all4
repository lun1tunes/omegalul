o_agent', 'Demo Agent', 'Демонстрационный агент-шаблон: считает скважины, упомянутые в задаче и в фактах других агентов, и умеет запускать долгий расчёт, результат которого приходит позже. Не читает файлы, не пишет SCHEDULE. Использовать только когда инженер прямо просит демонстрацию или подсчёт скважин.', '[]'::jsonb, '[\\\"well_count\\\",\\\"wells\\\"]'::jsonb, '{\\\"kind\\\":\\\"n8n_workflow\\\",\\\"workflow_id\\\":\\\"f8166995-01e4-5712-938c-2d1a492d564f\\\",\\\"workflow_name\\\":\\\"Agent — Demo Agent\\\"}'::jsonb, '{\\\"handoff_message\\\":\\\"что посчитать или какой расчёт запустить\\\"}'::jsonb, '{\\\"data\\\":{\\\"well_count\\\":\\\"число скважин\\\",\\\"wells\\\":\\\"[имена скважин]\\\"}}'::jsonb, 'agent_asks', false, '2') ON CONFLICT (agent_id) DO UPDATE SET invoke = CASE WHEN agent_registry.invoke = '{}'::jsonb THEN EXCLUDED.invoke ELSE agent_registry.invoke END, input_schema = CASE WHEN agent_registry.input_schema = '{}'::jsonb THEN EXCLUDED.input_schema ELSE agent_registry.input_schema END, output_schema = CASE WHEN agent_registry.output_schema = '{}'::jsonb THEN EXCLUDED.output_schema ELSE agent_registry.output_schema END, hitl_policy = CASE WHEN agent_registry.hitl_policy = 'agent_asks' THEN EXCLUDED.hitl_policy ELSE agent_registry.hitl_policy END, version = CASE WHEN agent_registry.version = '1' THEN EXCLUDED.version ELSE agent_registry.version END;\"+(wipe?wipeSql:'')+`SELECT true AS schema_ok;`;\nelse if(op==='create_case'){query='INSERT INTO cases(case_id,state,status,updated_at) VALUES($1,$2::jsonb,$3,now()) ON CONFLICT(case_id) DO NOTHING RETURNING case_id,state,status,updated_at';params=[caseId,j(raw.state),s(raw.status||'new')];}\nelse if(op==='get_case'){query='SELECT case_id,state,status,updated_at FROM cases WHERE case_id=$1';params=[caseId];}\nelse if(op==='list_cases'){query=\"SELECT c.case_id,c.status,c.updated_at,c.state,(SELECT COUNT(*) FROM events e WHERE e.case_id=c.case_id) AS event_count,COALESCE((SELECT jsonb_agg(jsonb_build_obje