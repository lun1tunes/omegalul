                {
                  "contract": "schedule_knowledge_block",
                  "contract_version": "1.0",
                  "target_base": "schedule_mvp",
                  "knowledge_type": "keyword_instruction",
                  "knowledge_id": "fracture-specs-v1",
                  "revision": "2",
                  "title": "FRACTURE_SPECS — привязка трещин к WELLTRACK",
                  "keywords": [
