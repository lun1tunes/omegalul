ld\": \"BHP\", \"min\": 0}, {\"field\": \"THP\", \"min\": 0}, {\"field\": \"VFP_TABLE\", \"min\": 0}, {\"field\": \"ALQ\", \"min\": 0}]}}, {\"schema_id\": \"expert:WCONPROD:grup\", \"schema_revision\": \"1\", \"keyword\": \"WCONPROD\", \"variant\": \"grup\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.42 / 1820-1824\", \"heading\": \"WCONPROD\", \"source_hash\": \"sha256:c42f5bebb086ba9027579f095ec8cc5a986cd99d0b4d20c75a191477cca4cbc1\"}, \"parser\": {\"token_width\": 20, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"WELL\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"STATUS\", \"position\": 2, \"type\": \"string\", \"required\": true, \"enum\": [\"OPEN\", \"STOP\", \"SHUT\", \"AUTO\"]}, {\"name\": \"CONTROL\", \"position\": 3, \"type\": \"string\", \"required\": true, \"enum\": [\"GRUP\"]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"FORECAST\", \"clock\": {\"uses_current\": true}, \"references\": [{\"entity_type\": \"well\", \"id_field\": \"WELL\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"WELSPECS\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}], \"state_assignments\": [{\"namespace\": \"well-control\", \"entity_type\": \"well\", \"entity_field\": \"WELL\", \"key_fields\": [\"CONTROL\"], \"value_fields\": [\"STATUS\"]}], \"numeric_constraints\": []}}]}}, {\"contract\": \"schedule_knowledge_block\", \"contract_version\": \"1.0\", \"target_base\": \"schedule_mvp\", \"knowledge_type\": \"keyword_instruction\", \"knowledge_id\": \"wconinje-forecast-inject-v1\", \"revision\": \"4\", \"title\": \"WCONINJE — прогнозный контроль нагнетания\", \"keywords\": [\"WCONINJE\"], \"topics\": [\"нагнетание\", \"WCONINJE\", \"WATER OIL GAS MULTI\", \"не WCONPROD\", \"не WCONINJH\", \"не WCONINJ\"], \"task_patterns\": [\"задать WCONINJE\", \"закачка воды RATE\", \"injector BHP\", \"MULTI закачка\", \"WCONINJE вместо WCONPROD\"], \"simulator_family\": [\"E100\", \"E300\", \"tNavigator\"], \"status\": \"active\", \"author\": \"department-hydrodynamic-expert\", \"access_scope\": \"petroleum-engineering\", \"text\": \"WCONINJE — прогнозный контроль нагнетательной скважины.\\n\\nНазначение. Задаёт статус и режим управления закачкой (вода/нефть/газ/MULTI/…) на текущих часах SCHEDULE. Параметры можно точечно менять WELTARG. Форматы: tN, E1, E3. Секция: SCHEDULE. Это не добыча (WCONPROD), не hist-inject (WCONINJH; вне allowlist → needs_input), не короткий синоним WCONINJ (§12.20.45) — эмитьте только WCONINJE.\\n\\nКогда применять. FORECAST / после cutover для injector. После WELSPECS (+ перфорации к осмысленной закачке). Не эмитьте WCONINJE в history interval — там WCONINJH. GROUP-контроль GRUP требует GCONINJE (эмитьте GCONINJE из allowlist или KEEP baseline; без групповой цели → needs_input). E3 GAS/HCGAS/HCOIL часто требуют WINJGAS (allowlist) или KEEP baseline состава.\\n\\nRecord layout. Keyword WCONINJE, записи `/`, блок — отдельный `/`. WELL или `*LIST` после WLIST.\\n\\nПоля (§12.20.44; METRIC):\\n\\n1. WELL — скважина или `*LIST`.\\n2. FLUID — WATER|WAT | OIL | GAS | MULTI | HCGAS | HCOIL.\\n   - MULTI (§2.14.6): основная фаза = WELSPECS preferred phase; RATE (поле 5) = лимит основной фазы; доли — поля 12–14 (>0).\\n   - E1: HCGAS≡GAS, HCOIL≡OIL.\\n3. STATUS — OPEN | STOP | SHUT. Default: OPEN.\\n4. CONTROL — RATE | BHP | THP | RESV | GRUP.\\n5. SURFACE_RATE — закачка surface sm3/day (лимит). Default: 1e6. MULTI → основная фаза.\\n6. RESV_RATE — пластовая rm3/day. Default: 1e6.\\n7. BHP — barsa (цель/лимит). Default: 6801·patm (или FBHPDEF).\\n8. THP — barsa. Default: omit/0 path per facts.\\n9. VFP_TABLE — VFPINJ. Default: 0.\\n10–11. IGNORED (E1/E3 compat) — не эмитьте без факта совместимости.\\n12–14. FOIL FWAT FGAS — доли MULTI surface (≥0; для MULTI из фактов).\\n\\nПереключение RATE↔BHP (§12.20.44): при RATE, если pBH выше лимита BHP → BHP; при BHP, если rate выше SURFACE_RATE → RATE; обратная проверка на шагах.\\n\\nКанон render MVP.\\n- `water_rate` — WATER/WAT OPEN CONTROL=RATE surface [resv] [BHP limit…] (пример 1043/1054).\\n- `water_bhp` — WATER/WAT OPEN CONTROL=BHP surface_or_* BHP_value (пример 43/54).\\n- `multi` — FLUID=MULTI + CONTROL + доли FOIL FWAT FGAS (пример 121R).\\n- CONTROL=THP (нужен THP+VFPINJ table) / RESV / GRUP без dedicated variant → needs_input; OIL/GAS/HCGAS/HCOIL rate/bhp без отдельного variant → needs_input или KEEP baseline.\\nНе эмитьте WCONINJ. Не копируйте учебные 253.1/400 без фактов.\\n\\nIR / semantics.\\n- period=FORECAST; clock.uses_current=true.\\n- references well WELL; prerequisites WELSPECS ENTITY.\\n- state_assignments namespace well-control-inj.\\n- numeric: rates/pressures ≥0; MULTI fractions ≥0.\\n\\nТеория (§2.14.6 — MULTI; приток §5.6).\\n- MULTI — одновременная закачка фаз; доли 12–14 и основная фаза из WELSPECS.\\n- BHP-контроль опирается на модель притока (§5.6 / (2.126)); RATE↔BHP auto-switch как выше.\\n- E3 молярный расход: GAS/WATER — постоянная молярная плотность; HCGAS/HCOIL — flash STCOND (детали §12.20.44) — не упрощать без факта; состав — WINJGAS.\\n\\nАнтипаттерны.\\n- WCONPROD вместо WCONINJE на injector.\\n- WCONINJE в HISTORY.\\n- GRUP без GCONINJE (и без baseline group-inject-control).\\n- GAS E3 без WINJGAS/фактов состава и без baseline.\\n- MULTI без долей / без preferred phase.\\n\\nНехватка факта → needs_input: нет WELL/FLUID/CONTROL; нет rate/BHP; MULTI без долей; THP/RESV/GRUP path; OIL/GAS/HC* без variant; E3 gas composition; hist inject; GCONINJE для GRUP.\\n\\nКарточка самодостаточна.\", \"examples\": [{\"title\": \"WATER RATE — канон\", \"task\": \"1043/1054 WATER OPEN RATE 253.1; у 1054 BHP lim=400.\", \"schedule_text\": \"WCONINJE\\n1043 WATER OPEN RATE 253.1 2* /\\n1054 WATER OPEN RATE 253.1 1* 400 /\\n/\\n\", \"explanation\": \"§12.20.44 пример 1. Variant water_rate.\"}, {\"title\": \"WATER BHP\", \"task\": \"43/54 WATER OPEN BHP с surface 255 и BHP 55/45.\", \"schedule_text\": \"WCONINJE\\n43 WATER OPEN BHP 255 1* 55 /\\n54 WATER OPEN BHP 255 1* 45 /\\n/\\n\", \"explanation\": \"Пример 2. Variant water_bhp.\"}, {\"title\": \"MULTI доли\", \"task\": \"121R MULTI OPEN BHP; oil frac 0.8 water 0.2.\", \"schedule_text\": \"WCONINJE\\n121R MULTI OPEN BHP 100 1* 4000 4* 0.8 0.2 /\\n/\\n\", \"explanation\": \"Пример 3. Variant multi. Preferred phase — WELSPECS.\"}], \"schema_catalogue\": {\"contract\": \"schedule_schema_catalogue\", \"contract_version\": \"1.0\", \"catalogue_ref\": \"catalogue://tnavigator/22.2/wconinje-forecast-inject-v1\", \"catalogue_hash\": \"sha256:23aad3e0d0c6e18c21ae21c924bd923e672f3b083ad5e34acd28569fd8bd1231\", \"source_hash\": \"sha256:035da2f9fcd6c0ce3f30301db8cbe7cad9b0eb686688ac26889abf892b574857\", \"access_scope\": \"petroleum-engineering\", \"simulator_profile\": {\"vendor\": \"Rock Flow Dynamics\", \"simulator\": \"tNavigator\", \"version\": \"22.2\", \"unit_system\": \"METRIC\"}, \"approved\": true, \"approved_by\": \"department-hydrodynamic-expert\", \"author\": \"department-hydrodynamic-expert\", \"approval_gate_id\": \"expert:wconinje-forecast-inject-v1:4\", \"schemas\": [{\"schema_id\": \"expert:WCONINJE:water_rate\", \"schema_revision\": \"1\", \"keyword\": \"WCONINJE\", \"variant\": \"water_rate\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.44 / 1828-1832\", \"heading\": \"WCONINJE\", \"source_hash\": \"sha256:035da2f9fcd6c0ce3f30301db8cbe7cad9b0eb686688ac26889abf892b574857\"}, \"parser\": {\"token_width\": 14, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"WELL\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"FL