50\"}, \"parser\": {\"token_width\": 19, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"GROUP\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"CONTROL\", \"position\": 2, \"type\": \"string\", \"required\": true, \"enum\": [\"NONE\"]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"FORECAST\", \"clock\": {\"uses_current\": true}, \"references\": [{\"entity_type\": \"group\", \"id_field\": \"GROUP\", \"required\": true}], \"state_assignments\": [{\"namespace\": \"group-control\", \"entity_type\": \"group\", \"entity_field\": \"GROUP\", \"key_fields\": [\"CONTROL\"], \"value_fields\": [\"CONTROL\"]}], \"numeric_constraints\": []}}, {\"schema_id\": \"expert:GCONPROD:fld\", \"schema_revision\": \"1\", \"keyword\": \"GCONPROD\", \"variant\": \"fld\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.89 / 1928-1932\", \"heading\": \"GCONPROD\", \"source_hash\": \"sha256:858bbd62b39f9f8ae74ec09a9fbbd5b4580fd41977f2677aa3bbb1ab2531bf50\"}, \"parser\": {\"token_width\": 19, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"GROUP\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"CONTROL\", \"position\": 2, \"type\": \"string\", \"required\": true, \"enum\": [\"FLD\"]}, {\"name\": \"ORAT\", \"position\": 3, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"WRAT\", \"position\": 4, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"GRAT\", \"position\": 5, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"LRAT\", \"position\": 6, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"EXCEED_ACTION\", \"position\": 7, \"type\": \"string\", \"required\": false, \"enum\": [\"NONE\", \"CON\", \"CON+\", \"+CON\", \"WELL\", \"RATE\", \"TARG\"], \"default_allowed\": true}, {\"name\": \"EXCEED_PARENT\", \"position\": 8, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"enum\": [\"YES\", \"NO\"]}, {\"name\": \"GUIDE_RATE\", \"position\": 9, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"GUIDE_PHASE\", \"position\": 10, \"type\": \"string\", \"required\": false, \"default_allowed\": true, \"enum\": [\"OIL\", \"WAT\", \"GAS\", \"LIQ\", \"WGA\", \"CVAL\", \"POTN\", \"FORM\"]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"FORECAST\", \"clock\": {\"uses_current\": true}, \"references\": [{\"entity_type\": \"group\", \"id_field\": \"GROUP\", \"required\": true}], \"state_assignments\": [{\"namespace\": \"group-control\", \"entity_type\": \"group\", \"entity_field\": \"GROUP\", \"key_fields\": [\"CONTROL\"], \"value_fields\": [\"GUIDE_RATE\", \"GUIDE_PHASE\", \"EXCEED_ACTION\", \"EXCEED_PARENT\"]}], \"numeric_constraints\": [{\"field\": \"GUIDE_RATE\", \"min\": 0}]}}]}}, {\"contract\": \"schedule_knowledge_block\", \"contract_version\": \"1.0\", \"target_base\": \"schedule_mvp\", \"knowledge_type\": \"keyword_instruction\", \"knowledge_id\": \"branprop-network-branch-v1\", \"revision\": \"2\", \"title\": \"BRANPROP — ветви расширенной сети\", \"keywords\": [\"BRANPROP\"], \"topics\": [\"расширенная сеть\", \"BRANPROP\", \"ветвь NETWORK\", \"VFP ветви\", \"штуцер 9999\", \"перед NODEPROP\"], \"task_patterns\": [\"задать ветвь сети BRANPROP\", \"подключить группу к FIELD через сеть\", \"VFP на ветви сети\", \"ветвь без потери давления 9999\", \"закрыть ветвь сети\", \"сеть после GRUPTREE\"], \"simulator_family\": [\"E100\", \"E300\", \"tNavigator\"], \"status\": \"active\", \"author\": \"department-hydrodynamic-expert\", \"access_scope\": \"petroleum-engineering\", \"text\": \"BRANPROP — ветви расширенной поверхностной сети (NETWORK).\\n\\nНазначение. BRANPROP задаёт рёбра расширенной сети: нижний узел → верхний узел, VFP-таблица потерь давления и ALQ. Расширенную сеть включает NETWORK в RUNSPEC (§12.1.92; вне allowlist Builder). Полная сеть = BRANPROP + NODEPROP (§12.20.106). Структура может отличаться от GRUPTREE (§12.20.103), но leaf-узлы (группы со скважинами) должны совпадать. Форматы: tN, E1, E3. Секция: SCHEDULE. Это не GRUPTREE, не NODEPROP (свойства узлов), не VFPPROD (сама таблица).\\n\\nКогда применять. Задача про extended network / автоматические штуцеры / компрессоры (§2.14.11). Требуется: NETWORK уже в base/.data (feature enabled). Если NETWORK нет в профиле/baseline → needs_input, не эмитьте NETWORK из этой карточки. BRANPROP до NODEPROP. Обычно после DATES; leaf-группы согласованы с GRUPTREE/WELSPECS.\\n\\nRecord layout. Keyword BRANPROP, затем одна или несколько записей `/`, блок — отдельный `/`.\\n\\nПоля (§12.20.105):\\n\\n1. DOWN_NODE — имя нижнего узла ветви (ближе к скважине).\\n2. UP_NODE — имя верхнего узла (ближе к вершине дерева / концевому узлу).\\n3. VFP_TABLE — номер таблицы:\\n   - VFPPROD / VFPCORR — добывающая сеть;\\n   - VFPINJ — нагнетательная сеть;\\n   - одна таблица может обслуживать несколько ветвей с одинаковыми характеристиками;\\n   - 9999 — нет падения давления в ветви; обязательно 9999 для ветвей-штуцеров (NODEPROP choke=YES на нижнем узле);\\n   - 0 — закрыть/удалить ветвь из сети (поток нижнего узла не добавляется в сеть).\\n   VFPPROD allowlist (body только artifact/baseline); VFPINJ вне allowlist → needs_input. Номер таблицы — из facts/baseline; иначе needs_input.\\n4. ALQ — искусственный лифт / параметр поиска в VFP (мощность насоса/компрессора). Для ветви с NETCOMPA — ALQ выключенного компрессора (обычно 0). Default: 0. UDQ допустим в симуляторе; MVP — число из фактов.\\n\\nКанон render.\\n- `vfp` — DOWN_NODE UP_NODE VFP_TABLE (ALQ omit/default 0).\\n- `with_alq` — DOWN_NODE UP_NODE VFP_TABLE ALQ.\\n- `no_drop` — DOWN_NODE UP_NODE VFP_TABLE=9999 (штуцер / без ΔP).\\n- `closed` — DOWN_NODE UP_NODE VFP_TABLE=0.\\nИмена узлов quoted. Не копируйте учебные GASALL/G1/таблица 2 без фактов. Граф без циклов; каждый leaf подключён к пути на концевой узел (давление фиксирует NODEPROP).\\n\\nIR / semantics.\\n- period=ANY; clock.uses_current=true.\\n- definitions: UPSERT entity_type=network_branch; id logically (DOWN_NODE, UP_NODE).\\n- references: network_node DOWN_NODE и UP_NODE (узлы появляются как endpoints ветвей; NODEPROP уточняет свойства).\\n- prerequisites текстовые: NETWORK feature; NODEPROP следует за полным набором ветвей. Жёсткий keyword-prerequisite на NETWORK/NODEPROP в schema не ставим (NETWORK вне allowlist; NODEPROP — соседняя карточка).\\n- numeric_constraints: VFP_TABLE min 0; ALQ min 0. Специальные значения 0 и 9999 — часть семантики variant.\\n\\nСвязанные keywords (не эмитьте без scope).\\n- NODEPROP — давление концевого узла, флаги штуцера; после BRANPROP.\\n- GRUPTREE — leaf-группы должны совпадать с leaf-узлами сети.\\n- VFPPROD / VFPCORR / VFPINJ — таблицы потерь.\\n- NETCOMPA — автокомпрессор на ветви.\\n- GCONPROD / WCONPROD — дебиты групп/скважин на leaf-узлах.\\n\\nВалидация.\\n- DOWN_NODE ≠ UP_NODE; оба непустые.\\n- VFP_TABLE ∈ {0, 9999} или положительный номер существующей VFP.\\n- Для choke-узла (NODEPROP YES) соответствующая вышележащая ветвь с VFP=9999.\\n- Не BRANPROP без NETWORK authority.\\n- Не подменяйте GRUPTREE сетью и наоборот.\\n\\nТеория (§2.14.11 — NETWORK / автоштуцеры / компрессоры).\\n- NETWORK (§12.1.92) включает расширенную сеть: целиком задаётся BRANPROP + NODEPROP (нагнетательная ветка — GNETINJE вне allowlist).\\n- Назначение опции: динамические ограничения THP по группам через баланс расходов и потерь давления в трубах (не путать со стандартной сетью GRUPNET §2.14.10).\\n- Иерархия GRUPTREE всё равно нужна; структура BRANPROP может отличаться от GRUPTREE, но leaf-группы со скважинами должны совпадать.\\n- Верхний узел — с фиксированным давлением; ΔP узел↔устье скважины — WNETDP.\\n\\nАнтипаттерны.\\n- Эмитить NETWORK из Schedule Builder.\\n- NODEPROP до BRANPROP.\\n- VFP≠9999 на штуцерной ветви.\\n- Выдумать номер VFP.\\n- Leaf сети ≠ leaf GRUPTREE.\\n\\nНехватка факта → needs_input: нет NETWORK в base; нет пар узлов; нет VFP id (и не 9999/0); нужен ALQ без числа; конфликт с baseline network без REVISE target; NODEPROP-only правка без ветвей.\\n\\nКарточка самодостаточна: renderer использует только schema_catalogue этой записи и выбранный variant.\", \"examples\": [{\"title\": \"Сеть с VFP и штуцерами — канон мануала\", \"task\": \"Ветви GASALL→FIELD, GAS1/GAS2→GASALL с VFP=2; leaf G1..G4→родители с 9999.\", \"schedule_text\": \"BRANPROP\\n'GASALL' 'FIELD' 2 /\\n'GAS1' 'GASALL' 2 /\\n'GAS2' 'GASALL' 2 /\\n'G1' 'GAS1' 9999 /\\n'G2' 'GAS1' 9999 /\\n'G3' 'GAS2' 9999 /\\n'G4' 'GAS2' 9999 /\\n/\\n\", \"explanation\": \"§12.20.105 с. 1971. Variants vfp (таблица 2) и no_drop (9999 на choke-ветвях). Учебные имена; NODEPROP/GRUPTREE — отдельные keywords.\"}, {\"title\": \"Одна VFP-ветвь\", \"task\": \"Ветвь от G1 к MANIFOLD, VFP таблица 1.\", \"schedule_text\": \"BRANPROP\\n  'G1' 'MANIFOLD' 1 /\\n/\\n\", \"explanation\": \"Variant vfp. Имена/номер таблицы из фактов.\"}, {\"title\": \"Ветвь без потери давления\", \"task\": \"Ветвь CHOKE1→GAS1 без ΔP (штуцер).\", \"schedule_text\": \"BRANPROP\\n  'CHOKE1' 'GAS1' 9999 /\\n/\\n\", \"explanation\": \"Variant no_drop. NODEPROP на CHOKE1 обычно choke=YES.\"}, {\"title\": \"Закрыть ветвь\", \"task\": \"Удалить ветвь G1→GAS1 из сети (VFP=0).\", \"schedule_text\": \"BRANPROP\\n  'G1' 'GAS1' 0 /\\n/\\n\", \"explanation\": \"Variant closed. Поток G1 не входит в сеть.\"}], \"schema_catalogue\": {\"contract\": \"schedule_schema_catalogue\", \"contract_version\": \"1.0\", \"catalogue_ref\": \"catalogue://tnavigator/22.2/branprop-network-branch-v1\", \"catalogue_hash\": \"sha256:ee5589bf8576ada7ffb3904e6d642aa78a301a3f0025c7837d7f36d7b074ab3a\", \"source_hash\": \"sha256:9b3df09b0d6f6a48cabac75806a6f902d676dc7d7ebdb4fc1e8862d2f7ac2e41\", \"access_scope\": \"petroleum-engineering\", \"simulator_profile\": {\"vendor\": \"Rock Flow Dynamics\", \"simulator\": \"tNavigator\", \"version\": \"22.2\", \"unit_system\": \"METRIC\"}, \"approved\": true, \"approved_by\": \"department-hydrodynamic-expert\", \"author\": \"department-hydrodynamic-expert\", \"approval_gate_id\": \"expert:branprop-network-branch-v1:2\", \"schemas\": [{\"schema_id\": \"expert:BRANPROP:vfp\", \"schema_revision\": \"1\", \"keyword\": \"BRANPROP\", \"variant\": \"vfp\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.105 / 1970-1972\", \"heading\": \"BRANPROP\", \"source_hash\": \"sha256:9b3df09b0d6f6a48cabac75806a6f902d676dc7d7ebdb4fc1e8862d2f7ac2e41\"}, \"parser\": {\"token_width\": 4, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"DOWN_NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"UP_NODE\", \"position\": 2, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"VFP_TABLE\", \"position\": 3, \"type\": \"integer\", \"required\": true}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"network_branch\", \"id_field\": \"DOWN_NODE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"network_node\", \"id_field\": \"DOWN_NODE\", \"required\": true}, {\"entity_type\": \"network_node\", \"id_field\": \"UP_NODE\", \"required\": true}], \"numeric_constraints\": [{\"field\": \"VFP_TABLE\", \"min\": 1}, {\"field\": \"ALQ\", \"min\": 0}]}}, {\"schema_id\": \"expert:BRANPROP:with_alq\", \"schema_revision\": \"1\", \"keyword\": \"BRANPROP\", \"variant\": \"with_alq\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.105 / 1970-1972\", \"heading\": \"BRANPROP\", \"source_hash\": \"sha256:9b3df09b0d6f6a48cabac75806a6f902d676dc7d7ebdb4fc1e8862d2f7ac2e41\"}, \"parser\": {\"token_width\": 4, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"DOWN_NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"UP_NODE\", \"position\": 2, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"VFP_TABLE\", \"position\": 3, \"type\": \"integer\", \"required\": true}, {\"name\": \"ALQ\", \"position\": 4, \"type\": \"number\", \"required\": true}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"network_branch\", \"id_field\": \"DOWN_NODE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"network_node\", \"id_field\": \"DOWN_NODE\", \"required\": true}, {\"entity_type\": \"network_node\", \"id_field\": \"UP_NODE\", \"required\": true}], \"numeric_constraints\": [{\"field\": \"VFP_TABLE\", \"min\": 0}, {\"field\": \"ALQ\", \"min\": 0}]}}, {\"schema_id\": \"expert:BRANPROP:no_drop\", \"schema_revision\": \"1\", \"keyword\": \"BRANPROP\", \"variant\": \"no_drop\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.105 / 1970-1972\", \"heading\": \"BRANPROP\", \"source_hash\": \"sha256:9b3df09b0d6f6a48cabac75806a6f902d676dc7d7ebdb4fc1e8862d2f7ac2e41\"}, \"parser\": {\"token_width\": 4, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"DOWN_NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"UP_NODE\", \"position\": 2, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"VFP_TABLE\", \"position\": 3, \"type\": \"integer\", \"required\": true, \"enum\": [9999]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"network_branch\", \"id_field\": \"DOWN_NODE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"network_node\", \"id_field\": \"DOWN_NODE\", \"required\": true}, {\"entity_type\": \"network_node\", \"id_field\": \"UP_NODE\", \"required\": true}], \"numeric_constraints\": [{\"field\": \"VFP_TABLE\", \"min\": 9999, \"max\": 9999}, {\"field\": \"ALQ\", \"min\": 0}]}}, {\"schema_id\": \"expert:BRANPROP:closed\", \"schema_revision\": \"1\", \"keyword\": \"BRANPROP\", \"variant\": \"closed\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.105 / 1970-1972\", \"heading\": \"BRANPROP\", \"source_hash\": \"sha256:9b3df09b0d6f6a48cabac75806a6f902d676dc7d7ebdb4fc1e8862d2f7ac2e41\"}, \"parser\": {\"token_width\": 4, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"DOWN_NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"UP_NODE\", \"position\": 2, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"VFP_TABLE\", \"position\": 3, \"type\": \"integer\", \"required\": true, \"enum\": [0]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"network_branch\", \"id_field\": \"DOWN_NODE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"network_node\", \"id_field\": \"DOWN_NODE\", \"required\": true}, {\"entity_type\": \"network_node\", \"id_field\": \"UP_NODE\", \"required\": true}], \"numeric_constraints\": [{\"field\": \"VFP_TABLE\", \"min\": 0, \"max\": 0}, {\"field\": \"ALQ\", \"min\": 0}]}}]}}, {\"contract\": \"schedule_knowledge_block\", \"contract_version\": \"1.0\", \"target_base\": \"schedule_mvp\", \"knowledge_type\": \"keyword_instruction\", \"knowledge_id\": \"nodeprop-network-node-v1\", \"revision\": \"2\", \"title\": \"NODEPROP — свойства узлов расширенной сети\", \"keywords\": [\"NODEPROP\"], \"topics\": [\"узел расширенной сети\", \"NODEPROP\", \"фиксированное давление\", \"автоматический штуцер\", \"после BRANPROP\", \"NETWORK\"], \"task_patterns\": [\"задать давление концевого узла\", \"NODEPROP FIELD давление\", \"включить автоматический штуцер\", \"свойства узла сети\", \"NODEPROP после BRANPROP\", \"штуцер на leaf-группе\"], \"simulator_family\": [\"E100\", \"E300\", \"tNavigator\"], \"status\": \"active\", \"author\": \"department-hydrodynamic-expert\", \"access_scope\": \"petroleum-engineering\", \"text\": \"NODEPROP — свойства узлов расширенной поверхностной сети (NETWORK).\\n\\nНазначение. NODEPROP задаёт давление концевого узла, флаг автоматического штуцера на вышележащей ветви, учёт газлифта и привязку узла к группе. Расширенную сеть включает NETWORK в RUNSPEC (§12.1.92; вне allowlist). Полная сеть = BRANPROP (§12.20.105) + NODEPROP. Форматы: tN, E1, E3. Секция: SCHEDULE. Это не BRANPROP (рёбра), не GRUPTREE, не NETCHOKE (детальные свойства штуцера).\\n\\nПорядок. Ветви BRANPROP уже заданы. Затем NODEPROP. Указывайте только концевой узел с фиксированным давлением и узлы, чьи свойства отличаются от defaults. Верхний узел каждого дерева сети (концевой) обязан иметь фиксированное давление.\\n\\nКогда применять. Extended network / автоштуцеры / компрессоры (§2.14.11). NETWORK в base обязателен; иначе needs_input. Leaf-узлы согласованы с GRUPTREE leaf-группами со скважинами.\\n\\nRecord layout. Keyword NODEPROP, записи `/`, блок — отдельный `/`.\\n\\nПоля (§12.20.106; METRIC: barsa):\\n\\n1. NODE — имя узла.\\n2. PRESSURE — фиксированное давление концевого узла. Если узел не концевой — default или отрицательное. UDQ допустим в симуляторе; MVP — число из фактов.\\n3. CHOKE — YES | NO: вышележащая ветвь действует как автоматический штуцер (ограничение расхода через ΔP).\\n   - Вышележащая = к концевому узлу (отходящая для добычи / подводящая для закачки).\\n   - BRANPROP VFP=9999 → ΔP только в штуцере; иначе + расчёт по VFP.\\n   - Концевой узел нельзя ставить CHOKE=YES (нет вышележащей ветви).\\n   - YES: целевой дебит группы — GCONPROD (добыча) / GCONINJE (закачка; обе allowlist). Guide rates: см. мануал (подчинённые choke-группе не должны иметь guide; скважины choke-группы не на guide group control).\\n   Default: NO.\\n4. ADD_GASLIFT — YES | NO: прибавлять газлифт скважин группы к газу, входящему в сеть в узле-источнике. Для не-источников — default. Default: NO.\\n5. CHOKE_GROUP — группа, чей дебит штуцер удерживает. Нужен CHOKE=YES. Default: = NODE.\\n6. SOURCE_GROUP — для узла-источника/стока: группа скважин / вспомогательная группа. Игнорируется если не source/sink; в E1 имена узла и группы совпадают. Default: = NODE, если группа существует. WEFAC param 3 влияет на умножение потоков на efficiency.\\n\\nКанон render.\\n- `terminal` — NODE PRESSURE (концевой узел, напр. FIELD 20).\\n- `choke_yes` — NODE [PRESSURE default] CHOKE=YES (leaf-штуцеры; BRANPROP ветвь с 9999).\\n- `choke_no` — NODE [PRESSURE default] CHOKE=NO (промежуточные узлы явно).\\n- `choke_target` — как choke_yes + CHOKE_GROUP, если цель ≠ NODE.\\nНе эмитьте поля вне variant. Имена quoted. Не копируйте учебные FIELD/G1/20 без фактов.\\n\\nIR / semantics.\\n- period=ANY; clock.uses_current=true.\\n- definitions: UPSERT entity_type=network_node; id_field=NODE.\\n- references: network_node NODE; для choke_target — group CHOKE_GROUP; опционально group SOURCE_GROUP.\\n- prerequisites: BRANPROP уже определил ветви, инцидентные узлу (текстово; schema prerequisite BRANPROP scope не жёсткий GLOBAL — сеть может набираться пакетом). NETWORK feature в base.\\n- numeric_constraints: PRESSURE min_exclusive 0 при явном terminal давлении.\\n\\nСвязанные keywords (не эмитьте без scope).\\n- BRANPROP — до NODEPROP; VFP=9999 на choke-ветвях.\\n- GCONPROD — целевые дебиты для choke-групп.\\n- GRUPTREE — совпадение leaf.\\n- NETCHOKE — детальная корреляция штуцера (вне allowlist → needs_input).\\n- WEFAC — efficiency на source/sink потоках.\\n\\nВалидация.\\n- Хотя бы один terminal с PRESSURE > 0 на дерево.\\n- CHOKE=YES не на концевом узле.\\n- CHOKE=YES ⇒ соответствующая BRANPROP-ветвь с VFP=9999 (если ΔP только в штуцере) согласована с фактами.\\n- Не NODEPROP до BRANPROP.\\n- Не NETWORK из Builder.\\n\\nТеория (§2.14.11 — NETWORK; §2.14.12 — штуцеры).\\n- NODEPROP задаёт свойства узлов расширенной сети вместе с BRANPROP (§2.14.11).\\n- Штуцер (§2.14.12) ограничивает поток локальным сужением сечения (bean); используется для контроля расхода / перепада; подробная гидравлика — в теории, в MVP не выдумывайте параметры choke вне полей NODEPROP/фактов.\\n\\nАнтипаттерны.\\n- Только NODEPROP без ветвей.\\n- CHOKE=YES на FIELD/terminal.\\n- Выдумать давление концевого узла.\\n- Путать NODEPROP с NETCHOKE.\\n\\nНехватка факта → needs_input: нет NETWORK; нет BRANPROP/узлов; нет PRESSURE для terminal; CHOKE без YES/NO; CHOKE_GROUP без имени; конфликт baseline network без REVISE target.\\n\\nКарточка самодостаточна: renderer использует только schema_catalogue этой записи и выбранный variant.\", \"examples\": [{\"title\": \"Концевой узел + штуцеры — канон мануала\", \"task\": \"FIELD давление 20 barsa; промежуточные NO; leaf G1..G4 штуцеры YES.\", \"schedule_text\": \"NODEPROP\\n'FIELD' 20 /\\n'GASALL' 1* 'NO'/\\n'GAS1' 1* 'NO'/\\n'GAS2' 1* 'NO'/\\n'G1' 1* 'YES'/\\n'G2' 1* 'YES'/\\n'G3' 1* 'YES'/\\n'G4' 1* 'YES'/\\n/\\n\", \"explanation\": \"§12.20.106 с. 1975–1976. Variants terminal + choke_no + choke_yes. Перед этим BRANPROP/GRUPTREE. Учебные имена.\"}, {\"title\": \"Только концевое давление\", \"task\": \"Узел FIELD, фиксированное давление 25 barsa.\", \"schedule_text\": \"NODEPROP\\n  'FIELD' 25 /\\n/\\n\", \"explanation\": \"Variant terminal. Остальные узлы — симуляторные defaults, если не нужны явные флаги.\"}, {\"title\": \"Leaf-штуцер\", \"task\": \"Узел G1, автоматический штуцер YES.\", \"schedule_text\": \"NODEPROP\\n  'G1' 1* YES /\\n/\\n\", \"explanation\": \"Variant choke_yes. Ветвь G1→parent в BRANPROP обычно VFP=9999.\"}], \"schema_catalogue\": {\"contract\": \"schedule_schema_catalogue\", \"contract_version\": \"1.0\", \"catalogue_ref\": \"catalogue://tnavigator/22.2/nodeprop-network-node-v1\", \"catalogue_hash\": \"sha256:c0b2b64cf3f4f44ad53280c041267557b4d7c3dcaa7f441b592667f91cc4a0bd\", \"source_hash\": \"sha256:e315be6c6c9a66acbc08517f2faa382b4d46505c9c9da07826eec18d0fe557ad\", \"access_scope\": \"petroleum-engineering\", \"simulator_profile\": {\"vendor\": \"Rock Flow Dynamics\", \"simulator\": \"tNavigator\", \"version\": \"22.2\", \"unit_system\": \"METRIC\"}, \"approved\": true, \"approved_by\": \"department-hydrodynamic-expert\", \"author\": \"department-hydrodynamic-expert\", \"approval_gate_id\": \"expert:nodeprop-network-node-v1:2\", \"schemas\": [{\"schema_id\": \"expert:NODEPROP:terminal\", \"schema_revision\": \"1\", \"keyword\": \"NODEPROP\", \"variant\": \"terminal\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.106 / 1973-1976\", \"heading\": \"NODEPROP\", \"source_hash\": \"sha256:e315be6c6c9a66acbc08517f2faa382b4d46505c9c9da07826eec18d0fe557ad\"}, \"parser\": {\"token_width\": 6, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"PRESSURE\", \"position\": 2, \"type\": \"number\", \"required\": true}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"network_node\", \"id_field\": \"NODE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"network_node\", \"id_field\": \"NODE\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"BRANPROP\", \"scope\": \"GLOBAL\"}], \"state_assignments\": [{\"namespace\": \"network-node\", \"entity_type\": \"network_node\", \"entity_field\": \"NODE\", \"key_fields\": [\"NODE\"], \"value_fields\": [\"PRESSURE\"]}], \"numeric_constraints\": [{\"field\": \"PRESSURE\", \"min_exclusive\": 0}]}}, {\"schema_id\": \"expert:NODEPROP:choke_yes\", \"schema_revision\": \"1\", \"keyword\": \"NODEPROP\", \"variant\": \"choke_yes\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.106 / 1973-1976\", \"heading\": \"NODEPROP\", \"source_hash\": \"sha256:e315be6c6c9a66acbc08517f2faa382b4d46505c9c9da07826eec18d0fe557ad\"}, \"parser\": {\"token_width\": 6, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"NODE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"PRESSURE\", \"position\": 2, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"CHOKE\", \"position\": 3, \"type\": \"string\", \"required\": true, \"enum\": [\"YES\"]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"perio