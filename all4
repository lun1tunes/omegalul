                  "knowledge_id": "branprop-network-branch-v1",
                  "revision": "2",
                  "title": "BRANPROP — ветви расширенной сети",
                  "keywords": [
                    "BRANPROP"
                  ],
                  "topics": [
                    "расширенная сеть",
                    "BRANPROP",
                    "ветвь NETWORK",
                    "VFP ветви",
                    "штуцер 9999",
