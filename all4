n_interval\", \"id_field\": \"WELL\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"well\", \"id_field\": \"WELL\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"WELSPECS\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}, {\"keyword\": \"WELLTRACK\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}], \"numeric_constraints\": [{\"field\": \"BRANCH\", \"min\": 0}, {\"field\": \"MDL\", \"min\": 0}, {\"field\": \"MDU\", \"min\": 0}, {\"field\": \"DIAMETER\", \"min_exclusive\": 0}]}}, {\"schema_id\": \"expert:COMPDATMD:tvd\", \"schema_revision\": \"1\", \"keyword\": \"COMPDATMD\", \"variant\": \"tvd\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.10 / 1740-1744\", \"heading\": \"COMPDATMD\", \"source_hash\": \"sha256:14c712b5c98063b690cb6434aef89632dac01e2cecee8ed14215e94c81f38d94\"}, \"parser\": {\"token_width\": 14, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"WELL\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"BRANCH\", \"position\": 2, \"type\": \"integer\", \"required\": false, \"default_allowed\": true}, {\"name\": \"MDL\", \"position\": 3, \"type\": \"number\", \"required\": true}, {\"name\": \"MDU\", \"position\": 4, \"type\": \"number\", \"required\": true}, {\"name\": \"DEPTH_TYPE\", \"position\": 5, \"type\": \"string\", \"required\": true, \"enum\": [\"TVD\"]}, {\"name\": \"STATUS\", \"position\": 6, \"type\": \"string\", \"required\": true, \"enum\": [\"OPEN\", \"SHUT\"]}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"completion_interval\", \"id_field\": \"WELL\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"well\", \"id_field\": \"WELL\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"WELSPECS\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}, {\"keyword\": \"WELLTRACK\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL\", \"prerequisite_entity_field\": \"WELL\"}], \"numeric_constraints\": [{\"field\": \"BRANCH\", \"min\": 0}]}}, {\"schema_id\": \"expert:COMPDATMD:stage\", \"schema_revision\": \"1\", \"keyword\": \"COMPDATMD\", \"variant\": \"stage\", \"citation\": {\"document_id\": \"tnav-user-manual-russian\", \"document_revision\": \"19.4\", \"page\": \"12.20.10 / 1740-1744\", \"heading\": \"COMPDATMD\", \"source_hash\": \"sha256:14c712b5c98063b690cb6434aef89632dac01e2cecee8ed14215e94c81f38d94\"}, \"parser\": {\"token_width\": 14, \"allow_trailing_omission\": true, \"allow_unquoted_strings\": true}, \"fields\": [{\"name\": \"STAGE\", \"position\": 1, \"type\": \"string\", \"required\": true, \"quote\": \"single\"}, {\"name\": \"STAGE_INDEX\", \"position\": 2, \"type\": \"integer\", \"required\": false, \"default_allowed\": true}, {\"name\": \"DELTA1\", \"position\": 3, \"type\": \"number\", \"required\": true}, {\"name\": \"DELTA2\", \"position\": 4, \"type\": \"number\", \"required\": true}, {\"name\": \"DEPTH_TYPE\", \"position\": 5, \"type\": \"string\", \"required\": true, \"enum\": [\"STAGE\"]}, {\"name\": \"STATUS\", \"position\": 6, \"type\": \"string\", \"required\": true, \"enum\": [\"OPEN\", \"SHUT\"]}, {\"name\": \"SAT_TABLE\", \"position\": 7, \"type\": \"integer\", \"required\": false, \"default_allowed\": true}, {\"name\": \"CF\", \"position\": 8, \"type\": \"number\", \"required\": false, \"default_allowed\": true}, {\"name\": \"DIAMETER\", \"position\": 9, \"type\": \"number\", \"required\": false, \"default_allowed\": true}], \"layout\": {\"newline\": \"LF\", \"indent\": \"  \", \"delimiter\": \"SPACE\", \"record_terminator\": \"SLASH\", \"block_terminator\": \"SLASH_LINE\"}, \"semantics\": {\"period\": \"ANY\", \"clock\": {\"uses_current\": true}, \"definitions\": [{\"entity_type\": \"completion_interval\", \"id_field\": \"STAGE\", \"action\": \"UPSERT\"}], \"references\": [{\"entity_type\": \"fracture_stage\", \"id_field\": \"STAGE\", \"required\": true}], \"prerequisites\": [{\"keyword\": \"FRACTURE_STAGE\", \"scope\": \"ENTITY\", \"entity_field\": \"STAGE\", \"prerequisite_entity_field\": \"STAGE\"}, {\"keyword\": \"FRACTURE_SPECS\", \"scope\": \"ENTITY\", \"entity_field\": \"WELL_OR_STAGE\", \"prerequisite_entity_field\": \"STAGE\"}], \"numeric_constraints\": [{\"field\": \"STAGE_INDEX\", \"min\": 0}, {\"field\": \"DELTA1\", \"min\": 0}, {\"field\": \"DELTA2\", \"min\": 0}, {\"field\": \"DIAMETER\", \"min_exclusive\": 0}]}}]}}, {\"contract\": \"schedule_knowledge_block\", \"contract_version\": \"1.0\", \"target_base\": \"schedule_mvp\", \"knowledge_type\": \"keyword_instruction\", \"knowledge_id\": \"wconprod-forecast-control-v1\", \"revision\": \"3\", \"title\": \"WCONPROD — прогнозный контроль добывающей скважины\", \"keywords\": [\"WCONPROD\"], \"topics\": [\"прогнозный контроль скважины\", \"WCONPROD\", \"ORAT WRAT GRAT LRAT\", \"BHP THP\", \"FORECAST\", \"не WCONHIST\"], \"task_patterns\": [\"задать прогнозный WCONPROD\", \"контроль по нефти ORAT\", \"лимит по воде WRAT\", \"контроль по жидкости LRAT\", \"контроль по BHP\", \"открыть добывающую скважину на прогнозе\"], \"simulator_family\": [\"E100\", \"E300\", \"tNavigator\"], \"status\": \"active\", \"author\": \"department-hydrodynamic-expert\", \"access_scope\": \"petroleum-engineering\", \"text\": \"WCONPROD — прогнозный контроль добывающей скважины (или списка скважин).\\n\\nНазначение. WCONPROD задаёт статус и режим управления добывающей скважины на текущих часах SCHEDULE: OPEN/STOP/SHUT/AUTO и контроль ORAT/WRAT/GRAT/LRAT/RESV/BHP/THP/… плюс лимиты по фазам и давлениям. Форматы: tN, E1, E3. Секция: только SCHEDULE. Это не история (WCONHIST), не нагнетание (WCONINJE/WCONINJH), не объявление скважины (WELSPECS) и не перфорация (COMPDAT/COMPDATMD).\\n\\nКогда применять. FORECAST / после cutover: целевые дебиты и давления прогноза. Не эмитьте WCONPROD в history interval — там WCONHIST. Не подменяйте WCONHIST «похожим» WCONPROD. VFP_TABLE — номер существующего VFPPROD (Prosper/baseline); 0 → THP не считается; тело таблицы не выдумывать. Обычно после DATES текущего time block и после WELSPECS (скважина должна существовать). Перфорации (COMPDATMD/COMPDAT) должны быть заданы к моменту осмысленной добычи, но entity-prerequisite этого корпуса — WELSPECS.\\n\\nRecord layout. Keyword WCONPROD, затем одна или несколько записей, каждая заканчивается `/`. Блок заканчивается отдельным `/`. Одна запись = одна скважина или `*LIST` после WLIST. Сырые маски без WLIST → needs_input.\\n\\nПоля по порядку (§12.20.42; METRIC unless noted):\\n\\n1. WELL — имя/номер скважины или `*LIST` (WLIST). Exact WELL копируйте из WELSPECS.\\n2. STATUS — OPEN | STOP | SHUT | AUTO. Default: OPEN.\\n   - AUTO: статус SHUT, но скважина открывается, когда позволяют ограничения (WDRILTIM, GRUPRIG, GECON, WELSOMIN и т.п.).\\n3. CONTROL — режим управления. Default: пусто (допустимо, если скважина SHUT/STOP и не в очереди на бурение). Для OPEN в прогнозе CONTROL обязателен из фактов.\\n   MVP black-oil (эмитьте свободно при наличии факта):\\n   - ORAT — дебит нефти;\\n   - WRAT — воды;\\n   - GRAT — газа;\\n   - LRAT — жидкости (нефть+вода на поверхности);\\n   - RESV — флюид в пластовых условиях (учитывает параметр 13 WELSPECS);\\n   - BHP — забойное давление (§5.6);\\n   - THP — устьевое давление (нужна VFP-таблица ≠0, иначе THP не считается);\\n   - GRUP — доля от GCONPROD группы.\\n   E3 / thermal / спецрежимы (WGRA, TMRA, STRA, SATP, SATT, CVAL, NGL) — только при явном E3/THERMAL scope и фактах; иначе needs_input, не угадывайте.\\n4. ORAT — дебит/верхний лимит нефти (sm3/day). UDQ допустим в симуляторе; корпус MVP — число из фактов.\\n5. WRAT — воды (sm3/day).\\n6. GRAT — газа (sm3/day; FIELD: Mscf/day).\\n7. LRAT — жидкости на поверхности (sm3/day). Default симулятора: 1e+20.\\n8. RESV — флюид в пластовых условиях (rm3/day). Default: 1e+20.\\n9. BHP — забойное давление или нижний лимит (barsa). Default E1: атмосферное; E3: 100 atma, если не FBHPDEF.\\n10. THP — устьевое давление или нижний лимит (barsa). 0 = только расчёт (если VFP≠0). Default: 0.\\n11. VFP_TABLE — номер VFPPROD/VFPCORR; 0 → THP не вычисляется. Default: 0. VFPPROD allowlist: номер + KEEP/ADD body только из artifact/baseline; без артефакта → needs_input (не invent body). VFPCORR вне allowlist.\\n12. ALQ — параметр искусственного подъёма для THP/VFP. Default: 0.\\n13. WGRA — жирный газ (E3).\\n14. TMRA — молярный расход (kg-M/day).\\n15. STRA — пар CWE (THERMAL).\\n16. SATP_DP — сдвиг ∆P для SATP (THERMAL).\\n17. SATT_DT — сдвиг ∆T для SATT (THERMAL).\\n18. CVAL — тепловой дебит (kJ/day, E3).\\n19. LINCOM — игнорируется (совместимость E1/E3).\\n20. NGL — ШФЛУ (E3).\\n\\nПоведение симулятора. Скважина стартует на заданном CONTROL; если лимит нарушен — переключается на неудовлетворённый контроль; при отрицательном дебите на текущем контроле — закрытие. WELTARG может позже менять цели. Групповой приоритет открытия может урезать дебит скважины несмотря на её собственные лимиты (§2.14.13).\\n\\nКанон render этого корпуса.\\nВыбирайте variant по CONTROL факта; не эмитьте поля вне variant.\\n- `orat` — WELL STATUS CONTROL=ORAT ORAT [WRAT GRAT LRAT RESV BHP].\\n- `wrat` — WELL STATUS CONTROL=WRAT [ORAT] WRAT.\\n- `grat` — WELL STATUS CONTROL=GRAT … GRAT.\\n- `lrat` — WELL STATUS CONTROL=LRAT ORAT WRAT GRAT LRAT (паттерн примера 1043).\\n- `bhp` — WELL STATUS CONTROL=BHP … BHP (дебиты — верхние лимиты; BHP — цель).\\n- `thp` — WELL STATUS CONTROL=THP … THP (+ VFP_TABLE если дан).\\n- `resv` — WELL STATUS CONTROL=RESV … RESV.\\n- `grup` — WELL STATUS CONTROL=GRUP (доли/лимиты — по фактам или defaults).\\nЧисла дебитов ≥0 и finite. Давления BHP/THP >0, если заданы явно как цель/лимит (не путайте с default-токеном 1*). Имена WELL quoted. Не копируйте учебные 1043/1054/18.19 без фактов.\\n\\nIR / semantics.\\n- period=FORECAST; clock.uses_current=true.\\n- references: well WELL required.\\n- prerequisites: WELSPECS scope=ENTITY по WELL.\\n- state_assignments: namespace well-control; key CONTROL; value_fields = заполненные rate/pressure поля variant.\\n- numeric_constraints: ORAT/WRAT/GRAT/LRAT/RESV/ALQ min 0; BHP/THP min_exclusive 0 при явном значении; VFP_TABLE min 0.\\n\\nСвязанные keywords (не эмитьте без scope).\\n- WELSPECS — обязателен; RESV читает параметр 13.\\n- WCONHIST — история, не прогноз.\\n- GCONPROD — групповой прогноз; CONTROL=GRUP опирается на него.\\n- WELTARG — смена цели без полного WCONPROD.\\n- VFPPROD/VFPCORR/WGASLIFT — THP/ALQ путь.\\n- WECON — economic limits / закрытие.\\n\\nВалидация.\\n- WELL существует; CONTROL согласован с заполненным целевым полем (ORAT→ORAT задан, BHP→BHP задан и т.д.).\\n- Не WCONPROD в HISTORY.\\n- Не сырые маски без WLIST; `*LIST` только после WLIST NEW/ADD.\\n- Не выдумывать VFP/ALQ/E3-поля.\\n- Несколько скважин — несколько записей в одном блоке на одной DATES.\\n\\nТеория (§5.6 — аппроксимация скважины; §2.14.13 — приоритеты).\\n- BHP-контроль опирается на модель притока скважины (§5.6 / §5.6.1): связь дебита и забойного давления через проводимость перфораций.\\n- Альтернатива пропорциональному делению группового дебита по guide — ввод/открытие по приоритетам (§2.14.13, PRIORITY/GCONPRI); не подменяйте GCONPROD+GUIDERAT приоритетами без факта.\\n\\nАнтипаттерны.\\n- WCONHIST вместо WCONPROD на прогнозе (и наоборот).\\n- CONTROL=ORAT без ORAT / CONTROL=BHP без BHP.\\n- THP без VFP при требовании расчёта устья.\\n- Подставить 1e+20 вручную вместо omit/default.\\n- Считать WCONPROD перфорацией или объявлением скважины.\\n\\nНехватка факта → needs_input: нет WELL; нет STATUS/CONTROL; нет величины для выбранного CONTROL; cutover/history-forecast граница неясна; нужен E3/THERMAL CONTROL без профиля; нужен VFP id без таблицы; конфликт с baseline control без REVISE target.\\n\\nКарточка самодостаточна: renderer использует только schema_catalogue этой записи и выбранный variant.\", \"examples\": [{\"title\": \"ORAT — нефтяной контроль\", \"task\": \"Скважина P01 OPEN, контроль по нефти 120 sm3/day.\", \"schedule_text\": \"WCONPROD\\n  'P01' OPEN ORAT 120 /\\n/\\n\", \"explanation\": \"Variant orat. WELSPECS для P01 уже должен существовать. Число из фактов.\"}, {\"title\": \"LRAT с лимитом нефти — канон мануала\", \"task\": \"Скважина 1043 OPEN LRAT: лимит нефти 18.19, жидкость 18.99.\", \"schedule_text\": \"WCONPROD\\n1043 OPEN LRAT 18.19\\n0 0 18.99 2* /\\n/\\n\", \"explanation\": \"§12.20.42 с. 1823. CONTROL=LRAT, ORAT=18.19 как вторичный лимит, WRAT=GRAT=0, LRAT=18.99, RESV/BHP default (2*). Учебные числа.\"}, {\"title\": \"ORAT с лимитом BHP — канон мануала\", \"task\": \"Скважина 1054 OPEN ORAT 16.38, вода 1.765, жидкость 18.14, BHP≥50.\", \"schedule_text\": \"WCONPROD\\n1054 OPEN ORAT 16.38 1.765 0 18.14 1* 50 /\\n/\\n\", \"explanation\": \"§12.20.42 с. 1823. Variant orat: CONTROL=ORAT + опциональные лимиты WRAT/LRAT и BHP=50. Учебные числа.\"}, {\"title\": \"BHP-контроль\", \"task\": \"Скважина P01 OPEN, контроль BHP=55 barsa, лимит нефти 18.19, жидкости 18.9.\", \"schedule_text\": \"WCONPROD\\n  'P01' OPEN BHP 18.19 0 0 18.9 1* 55 /\\n/\\n\", \"explanation\": \"Variant bhp. Дебиты — верхние лимиты; цель — BHP. Паттерн примера §12.20.42 с. 1824.\"}, {\"title\": \"GRUP — доля группы\", \"task\": \"Скважина P01 OPEN под групповым контролем GRUP.\", \"schedule_text\": \"WCONPROD\\n  'P01' OPEN GRUP /\\n/\\n\", \"explanation\": \"Variant grup. GCONPROD для группы скважины должен быть в scope/baseline. Без групповой цели → needs_input.\"}], \"schema_catalogue\": {\"contract\": \"schedule_schema_catalogue\", \"contract_version\": \"1.0\", \"catalogue_ref\": \"catalogue://tnavigator/22.2/wconprod-forecast-