# Demo Agent FastAPI. Copy to demo-agent.env.
# Поле: 0.0.0.0 если корпоративный n8n должен достучаться. lab: контейнер слушает 0.0.0.0 сам.
DEMO_AGENT_HOST=127.0.0.1
DEMO_AGENT_PORT=8300
# Activity on this workstation; the task normally carries inputs.activity_base_url, this is the fallback.
ACTIVITY_BASE_URL=http://127.0.0.1:8200
# How long the "long calculation" runs and how often it reports progress (seconds).
DEMO_JOB_SECONDS=40
DEMO_PROGRESS_EVERY_S=15
# DEMO_SESSIONS_DIR=data/sessions
