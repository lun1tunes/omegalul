# Docker Compose configuration only.
# Native Windows FastAPI uses excel-agent-tools/excel-tools.env instead.
# n8n workflow settings and model/database credentials are configured in the UI.

# PostgreSQL used by n8n, chat memory and PGVector.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPUS=2.0

# n8n 2.30.8 container runtime.
N8N_ENCRYPTION_KEY=change-me-at-least-32-characters
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-at-least-32-characters
N8N_RUNNERS_AUTH_TOKEN=change-me-at-least-32-characters
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_HOST_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
EXECUTIONS_DATA_MAX_AGE=168
N8N_RUNNERS_TASK_TIMEOUT=120
N8N_RUNNERS_MAX_CONCURRENCY=10
N8N_RUNNERS_MEMORY_LIMIT=512m
N8N_RUNNERS_CPUS=1.0
N8N_RUNNERS_TMPFS_SIZE=128m
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000
N8N_MEMORY_LIMIT=1g
N8N_CPUS=2.0

# FastAPI Excel tools container. This key is configured separately in the
# imported workflow's Runtime configuration node.
EXCEL_TOOLS_API_KEY=change-me-excel-tools-key
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=200
MAX_EXCEL_ZIP_ENTRIES=10000
MAX_EXCEL_UNCOMPRESSED_MB=500
MAX_INTERNAL_BLANK_ROWS=5
EXCEL_TOOLS_ENABLE_DOCS=false
EXCEL_TOOLS_MEMORY_LIMIT=2g
EXCEL_TOOLS_CPUS=2.0
EXCEL_TOOLS_TMPFS_SIZE=256m

# MAS Activity presentation UI (optional compose service).
MAS_ACTIVITY_KEY=change-me-activity-key
MAS_ACTIVITY_HOST_PORT=8200
MAS_ACTIVITY_MEMORY_LIMIT=256m
MAS_ACTIVITY_CPUS=0.5
HITL_MODE=local
# Live start/HITL from Activity (optional):
# ORCHESTRATOR_WEBHOOK_URL=http://n8n:5678/webhook/engineering-orchestrator
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=…header auth value…
# or HITL_MODE=n8n_rest + N8N_USERNAME/PASSWORD + ORCHESTRATOR_WORKFLOW_ID

# Activity ↔ n8n Data Tables (UI-importable webhooks; bind tables after import).
# Compose default reaches n8n on the Docker network. Leave empty to keep in-memory only.
ACTIVITY_LIST_URL=http://n8n:5678/webhook/mas-activity-list-tasks
ACTIVITY_FEED_URL=http://n8n:5678/webhook/mas-activity-load-feed
# ACTIVITY_DURABLE_AUTH_HEADER=Authorization
# ACTIVITY_DURABLE_AUTH_VALUE=…
ACTIVITY_STATE_PATH=/data/activity_state.json
MAS_KNOWLEDGE_CORPUS=/corpus/rag/excel-agent-operating-guide.documents.json
