# Copy this file to .env and replace every change-me value before starting services.
# All host ports bind to 127.0.0.1. Change only when these ports are already occupied.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n
POSTGRES_HOST_PORT=5432

N8N_ENCRYPTION_KEY=change-me-at-least-32-characters
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-at-least-32-characters
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_HOST_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

EXCEL_TOOLS_API_KEY=change-me-excel-tools-key
EXCEL_TOOLS_HOST_PORT=8000
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=200

# OpenAI-compatible Qwen endpoint used by the imported n8n agent workflow.
QWEN_BASE_URL=https://codex.sale/v1
QWEN_API_KEY=change-me-qwen-key
QWEN_MODEL=qwen3.6-plus
