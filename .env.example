# Copy this file to .env and replace every change-me value before starting services.
# n8n is bound to 127.0.0.1. PostgreSQL and Excel Tools are internal-only Docker
# services and intentionally have no host ports in the production compose file.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=change-me-at-least-32-characters
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-at-least-32-characters
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_HOST_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
# Set true only when n8n is served through HTTPS. Keep false for the local HTTP
# example above; production must use a TLS reverse proxy and https:// URLs.
N8N_SECURE_COOKIE=false
EXECUTIONS_DATA_MAX_AGE=168
# Shared only by n8n and the internal n8n-runners container. Generate at least 32 random bytes.
N8N_RUNNERS_AUTH_TOKEN=change-me-at-least-32-characters
N8N_RUNNERS_TASK_TIMEOUT=120
N8N_RUNNERS_MAX_CONCURRENCY=10
N8N_RUNNERS_MEMORY_LIMIT=512m
N8N_RUNNERS_CPUS=1.0
N8N_RUNNERS_TMPFS_SIZE=128m
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000
# Required on every webhook request as X-Excel-Webhook-Key. Put the public
# n8n endpoint behind TLS and a rate-limiting reverse proxy in production.
EXCEL_WEBHOOK_API_KEY=change-me-webhook-api-key

EXCEL_TOOLS_API_KEY=change-me-excel-tools-key
# Default is the internal Docker service. When FastAPI runs natively on Windows
# while n8n remains in Docker Desktop, use http://host.docker.internal:8000/api/v1.
EXCEL_TOOLS_URL=http://excel-tools:8000/api/v1
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=200
# OOXML (.xlsx/.xlsm) archives are zip files. These independent limits prevent
# highly-compressed archive payloads from exhausting memory or disk on parsing.
MAX_EXCEL_ZIP_ENTRIES=10000
MAX_EXCEL_UNCOMPRESSED_MB=500
# Consecutive fully empty rows that may be treated as an internal visual gap
# within one table. Keep this bounded to avoid merging separate report blocks.
MAX_INTERNAL_BLANK_ROWS=5
EXCEL_TOOLS_ENABLE_DOCS=false
EXCEL_TOOLS_MEMORY_LIMIT=2g
EXCEL_TOOLS_CPUS=2.0
EXCEL_TOOLS_TMPFS_SIZE=256m
N8N_MEMORY_LIMIT=1g
N8N_CPUS=2.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPUS=2.0

# OpenAI-compatible Qwen endpoint used by the imported n8n agent workflow.
OPENAI_API_KEY=change-me-openai-key
