      ],
      "task_patterns": [
        "задать ACTIONX",
        "условие по дате SCHEDULE",
        "ACTIONX WLPR",
        "условный GSATPROD",
        "закрыть ENDACTIO"
      ],
      "simulator_family": [
        "E100",
