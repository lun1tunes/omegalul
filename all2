      "revision": "2",
      "title": "ACTIONX — условный блок SCHEDULE",
      "keywords": [
        "ACTIONX"
      ],
      "topics": [
        "условный блок",
        "ACTIONX",
        "AND OR условия",
        "ENDACTIO",
