      "task_patterns": [
        "что означают комментарии в inc",
        "пропустить комментарии --",
        "учесть пояснения в .data",
        "не трогать комментарии при REVISE",
        "заметки инженера в schedule"
      ],
      "simulator_family": [
        "E100",
