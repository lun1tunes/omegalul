      ],
      "task_patterns": [
        "VFP таблица номер",
        "связать VFPPROD с WCONPROD",
        "VFP_TABLE в WCONHIST",
        "Prosper VFP",
        "THP контроль VFP"
      ],
      "simulator_family": [
        "E100",
