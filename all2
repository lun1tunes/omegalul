          "title": "Один интервал (горизонталь)",
          "task": "WU1 на [28,63,3], az=110, L=140, H=1/1, width=0.02.",
          "schedule_text": "WFRACP\n'WU1' 28 63 3 28 63 3 110 0 140 140 1 1 0.02 'PROPPANT1'\n'FLOWFUNC1' 'TIME' 3 0 0 0 0 0 0 0 /\n/\n",
          "explanation": "Пример 2. Variant point."
        },
        {
          "title": "Объём пропанта, все перфы",
          "task": "WU351: все перфы (6*), az=90, width=0.1, PROPANT 12/18, VOL=70.",
          "schedule_text": "WFRACP\n'WU351' 6* 90 0 0 0 0 0 0.1 'PROPPANT 12/18' 'FLOWFUNC1' 'TIME' 3\n0 0 0 0 0 0 70 /\n/\n",
          "explanation": "Пример 3. Полудлины/высоты из объёма/перфов. Variant proppant_vol."
        }
