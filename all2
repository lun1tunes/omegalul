      "knowledge_type": "keyword_instruction",
      "knowledge_id": "vfpprod-table-ref-v1",
      "revision": "2",
      "title": "VFPPROD — номер VFP-таблицы и связь с контролем",
      "keywords": [
        "VFPPROD"
      ],
      "topics": [
