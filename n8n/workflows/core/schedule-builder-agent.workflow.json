    {
      "parameters": {
        "toolDescription": "Объектная инвентаризация baseline: wells, factual/forecast WCONPROD, commissioning anchors, история режимов, keywords, даты и GRUPTREE. Без полного .INC.",
        "method": "POST",
        "url": "={{ $('Runtime configuration').first().json.schedule_service_url + '/agent-tools/' + \"inspect_schedule\" }}",
        "authentication": "none",
        "sendQuery": false,
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "sendBody": true,
