    {
      "parameters": {
        "jsCode": "const x=$json;const attempted=x.cas_attempted&&typeof x.cas_attempted==='object'&&!Array.isArray(x.cas_attempted)?x.cas_attempted:{};\nreturn [{json:{...attempted,status:'conflict',phase:'concurrency',message:'Invalid CAS persist request. Reload task status and retry with the current expected_version.',cas_succeeded:false,cas_operation:String(x.cas_operation||''),last_error_json:JSON.stringify({code:'INVALID_CAS_REQUEST',findings:x.cas_findings||[]})}}];"
      },
