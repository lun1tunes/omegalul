  "nodes": [
    {
      "parameters": {
        "content": "## CAS — Persist Task State (n8n 2.30.8)\nSingle Data Table binding for insert + optimistic update.\nOrchestrator passes `{cas_operation, attempted}` and receives the attempted in-memory state merged with the persisted row plus `cas_succeeded`.\nFail closed on invalid request, 0/N matched rows, or echoed input (alwaysOutputData).",
        "height": 280,
        "width": 520,
        "color": 5
      },
      "id": "5dbd775e-7e48-5741-a457-6d83a5624496",
      "name": "CAS persist README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -40
      ]
    },
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\"cas_operation\": \"update\", \"attempted\": {\"task_id\": \"eng_example\", \"version\": 2, \"previous_version\": 1, \"status\": \"delegated\", \"phase\": \"delegation\", \"task_type\": \"schedule_build\", \"risk_class\": \"high\", \"request_json\": \"{}\", \"context_json\": \"{}\", \"plan_json\": \"{}\", \"specialist_json\": \"{}\", \"result_json\": \"{}\", \"verification_json\": \"{}\", \"pending_human_json\": \"{}\", \"last_error_json\": \"{}\", \"retry_count\": 0, \"max_retries\": 2, \"history_json\": \"[]\", \"created_at\": \"2026-01-01T00:00:00.000Z\", \"updated_at\": \"2026-01-01T00:00:00.000Z\"}}"
      },
      "id": "57761f0f-e3b2-5fa1-b523-38732c5d7c11",
      "name": "Receive CAS persist request",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const root=$json;\nconst obj=v=>v&&typeof v==='object'&&!Array.isArray(v);\nconst attempted=obj(root.attempted)?root.attempted:(obj(root)&&typeof root.task_id==='string'?root:{});\nconst operation=String(root.cas_operation||'').trim();\nconst columns=['task_id','version','status','phase','task_type','risk_class','request_json','context_json','plan_json','specialist_json','result_json','verification_json','pending_human_json','last_error_json','retry_count','max_retries','history_json','created_at','updated_at'];\nconst present=key=>{const v=attempted[key];if(v===undefined||v===null)return false;if(typeof v==='number')return Number.isFinite(v);return true;};\nconst missing=columns.filter(key=>!present(key));\nconst findings=[];\nif(operation!=='insert'&&operation!=='update')findings.push({code:'CAS_OPERATION_INVALID',operation});\nif(typeof attempted.task_id!=='string'||!attempted.task_id.trim())findings.push({code:'CAS_TASK_ID_REQUIRED'});\nif(!Number.isInteger(Number(attempted.version)))findings.push({code:'CAS_VERSION_REQUIRED'});\nif(missing.length)findings.push({code:'CAS_STATE_COLUMNS_MISSING',fields:missing});\nif(operation==='update'){const prev=Number(attempted.previous_version);if(!Number.isInteger(prev)||prev<0)findings.push({code:'CAS_PREVIOUS_VERSION_REQUIRED'});}\nconst valid=findings.length===0;\nreturn [{json:{...attempted,cas_operation:operation,cas_attempted:attempted,cas_request_valid:valid,cas_findings:findings,cas_route:operation==='insert'?0:1}}];"
      },
