# MAS Activity UI. Copy to mas-activity.env and replace the key.
MAS_ACTIVITY_KEY=change-me-activity-key

# Local development only: set true to disable X-Activity-Key checks.
# Keep false on a shared/corporate-facing instance.
MAS_ACTIVITY_AUTH_DISABLED=false

# 127.0.0.1: only this Windows PC. 0.0.0.0: allow an approved remote n8n host.
MAS_ACTIVITY_HOST=127.0.0.1
MAS_ACTIVITY_PORT=8200

# local = offline UI / demo start. webhook or n8n_rest = live Orchestrator.
HITL_MODE=local

# Optional live Orchestrator (HITL + new-task start):
# ORCHESTRATOR_WEBHOOK_URL=http://127.0.0.1:5678/webhook/engineering-orchestrator
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=
# HITL_MODE=n8n_rest
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_USERNAME=
# N8N_PASSWORD=
# ORCHESTRATOR_WORKFLOW_ID=

# Optional knowledge corpus (default: ../n8n/rag/excel-agent-operating-guide.documents.json)
# Compose mounts ./n8n/rag → /corpus/rag
# MAS_KNOWLEDGE_CORPUS=/corpus/rag/excel-agent-operating-guide.documents.json

# После n8n UI import: bind Data Tables на Activity hydrate, activate webhooks.
# URL — корпоративный n8n (не docker DNS http://n8n:5678).
# ACTIVITY_LIST_URL=http://127.0.0.1:5678/webhook/mas-activity-list-tasks
# ACTIVITY_FEED_URL=http://127.0.0.1:5678/webhook/mas-activity-load-feed
# ACTIVITY_DURABLE_AUTH_HEADER=Authorization
# ACTIVITY_DURABLE_AUTH_VALUE=

# Optional on-disk store (survives Activity restart). Compose default: /data/activity_state.json
# Runtime only — never commit this file. Prefer a path outside the repo, or under gitignored data/.
# ACTIVITY_STATE_PATH=C:\mas-activity\activity_state.json
# ACTIVITY_STATE_PATH=/home/you/mas-activity/activity_state.json
