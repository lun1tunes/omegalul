# MAS Activity UI. Copy to mas-activity.env and replace the key.
MAS_ACTIVITY_KEY=change-me-activity-key

# 127.0.0.1: only this Windows PC. 0.0.0.0: allow an approved remote n8n host.
MAS_ACTIVITY_HOST=127.0.0.1
MAS_ACTIVITY_PORT=8200

# local = offline UI / demo start. webhook or n8n_rest = live Orchestrator.
HITL_MODE=local

# Optional live Orchestrator (HITL + new-task start):
# ORCHESTRATOR_WEBHOOK_URL=http://127.0.0.1:5678/webhook/engineering-orchestrator
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=
# HITL_MODE=n8n_rest
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_USERNAME=
# N8N_PASSWORD=
# ORCHESTRATOR_WORKFLOW_ID=

# Optional knowledge corpus (default: ../n8n/rag/excel-agent-operating-guide.documents.json)
# MAS_KNOWLEDGE_CORPUS=
