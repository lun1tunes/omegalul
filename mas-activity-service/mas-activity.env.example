# MAS Activity UI. Copy to mas-activity.env.
# python -m app (start-windows.bat / start-linux.sh) loads this file automatically.
# A process environment always wins. Comments: поле = Windows+корпоративный n8n; lab = Docker Compose.

# --- слушатель (поле: 0.0.0.0 если n8n на другом ПК; lab: контейнер сам слушает 0.0.0.0) ---
MAS_ACTIVITY_HOST=127.0.0.1
MAS_ACTIVITY_PORT=8200
LOG_LEVEL=INFO

# TLS к n8n. Поле: true + ACTIVITY_CA_BUNDLE=PEM корпоративного CA. lab: обычно true, бандл пуст.
ACTIVITY_TLS_VERIFY=true
# ACTIVITY_CA_BUNDLE=/absolute/path/to/corporate-ca.pem

# --- n8n: webhook (поле) или REST (lab, если заданы N8N_USERNAME/PASSWORD) ---
ORCHESTRATOR_WEBHOOK_URL=http://127.0.0.1:15678/webhook/mas-orchestrator-step
# N8N_BASE_URL=http://127.0.0.1:15678
# Ссылки «n8n ↗» в логе. Пусто = N8N_BASE_URL. Lab Compose: http://localhost:5678 (браузер ≠ n8n:5678).
# N8N_PUBLIC_URL=
# N8N_USERNAME=
# N8N_PASSWORD=
# ORCHESTRATOR_WORKFLOW_ID=e9bbdb6e-3b7c-5dc0-851a-30bd9f2eb0d6
# N8N_HEALTH_PATH=/healthz
# N8N_WEBHOOK_CHECKS=mas-orchestrator-step,mas-knowledge-ingest

# Header Auth webhook оркестратора — те же имя и значение, что credential в n8n.
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=

# --- Control Plane Proxy (обязателен на поле) ---
CONTROL_PLANE_REQUIRED=true
CONTROL_PLANE_PROXY_URL=http://127.0.0.1:15678/webhook/mas-control-plane
# CONTROL_PLANE_PROXY_AUTH_HEADER=Authorization
# CONTROL_PLANE_PROXY_AUTH_VALUE=
# CONTROL_PLANE_PROXY_TIMEOUT_S=120

# Knowledge Ingestion webhook. Пусто = N8N_BASE_URL/webhook/mas-knowledge-ingest.
# KNOWLEDGE_INGEST_URL=http://127.0.0.1:15678/webhook/mas-knowledge-ingest

# Ожидание одного шага оркестратора (Decision + агент). Должно быть > LLM_HTTP_TIMEOUT_MS (600 с).
# ORCHESTRATOR_INVOKE_TIMEOUT_S=1800
# «Продолжить» на running/waiting_agent, если последнее событие оркестратора старше (секунды).
# RESUME_STALE_S=120

# Опциональный корпус для UI знаний (lab Compose: /rag/…). Поле: путь к n8n/rag/*.documents.json
# MAS_KNOWLEDGE_CORPUS=
# ACTIVITY_STATE_PATH=C:\mas-activity\activity_state.json
# ACTIVITY_BINARIES_PATH=

# Снято: не задавать. Принимаются, чтобы старый .env не падал.
# ACTIVITY_HYDRATE_URL=
# ACTIVITY_LIST_URL=
# ACTIVITY_FEED_URL=
# ACTIVITY_DURABLE_AUTH_HEADER=
# ACTIVITY_DURABLE_AUTH_VALUE=
