# MAS Activity UI. Copy to mas-activity.env.
# python -m app (start-windows.bat / start-linux.sh) loads this file automatically,
# same pattern as excel-tools.env. A process environment always wins.

# 127.0.0.1: only this PC. 0.0.0.0: allow an approved remote n8n host.
MAS_ACTIVITY_HOST=127.0.0.1
MAS_ACTIVITY_PORT=8200
LOG_LEVEL=INFO
# Keep true in production. Set false only for a trusted local/self-signed endpoint.
ACTIVITY_TLS_VERIFY=true
# Preferred for corporate/self-signed PKI: keep verification enabled and point to a CA PEM.
# ACTIVITY_CA_BUNDLE=/absolute/path/to/corporate-ca.pem

# n8n — production path only (no local demo mode).
# Start Control Plane Proxy (and bind Header Auth) before this process.
ORCHESTRATOR_WEBHOOK_URL=http://127.0.0.1:15678/webhook/mas-orchestrator-step
# Unified control-plane proxy. n8n Postgres nodes own cases, events, HITL, artifacts.
# Required for production. Leave false only for standalone/unit-test memory mode.
CONTROL_PLANE_REQUIRED=true
CONTROL_PLANE_PROXY_URL=http://127.0.0.1:15678/webhook/mas-control-plane
# CONTROL_PLANE_PROXY_AUTH_HEADER=Authorization
# CONTROL_PLANE_PROXY_AUTH_VALUE=
# CONTROL_PLANE_PROXY_TIMEOUT_S=120
# If the webhook uses header auth in n8n:
# ORCHESTRATOR_AUTH_HEADER=Authorization
# ORCHESTRATOR_AUTH_VALUE=
# N8N_BASE_URL=http://127.0.0.1:15678
# KNOWLEDGE_INGEST_URL=http://127.0.0.1:15678/webhook/mas-knowledge-ingest

# Do not set ACTIVITY_HYDRATE_URL. Activity — Hydrate is retired; cases live in Postgres via the proxy.

# Optional knowledge corpus (default: ../n8n/rag/excel-agent-operating-guide.documents.json)
# Compose mounts ./n8n/rag → /corpus/rag
# MAS_KNOWLEDGE_CORPUS=/corpus/rag/excel-agent-operating-guide.documents.json

# Optional on-disk store (survives Activity restart). Compose default: /data/activity_state.json
# Runtime only — never commit this file.
# ACTIVITY_STATE_PATH=C:\mas-activity\activity_state.json
# ACTIVITY_STATE_PATH=/home/you/mas-activity/activity_state.json
