{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegalul.local/schemas/agent_result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "status"],
  "properties": {
    "task_id": { "type": "string" },
    "status": { "enum": ["completed", "needs_input", "failed"] },
    "message": { "type": "string" },
    "data": { "type": "object" },
    "artifacts": { "type": "object" },
    "issues": { "type": "array" },
    "assumptions": { "type": "array" },
    "requests": { "type": "array" }
  }
}
